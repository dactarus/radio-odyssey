---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Sidebar from '../components/Sidebar.astro';
import FAQBlock from '../components/FAQBlock.astro';
import RelatedPages from '../components/RelatedPages.astro';
import NewsletterCapture from '../components/NewsletterCapture.astro';

// Dixième quiz du site, proposé par le propriétaire : la version diffusée
// sur Radio Odyssey est parfois une reprise — l'artiste qui a réellement
// créé le titre n'est pas celui qu'on entend. Question posée : « Quel
// artiste ou groupe original avait chanté ce titre ? »
//
// Format volontairement différent des 9 quiz précédents : ici, l'artiste
// diffusé sur Radio Odyssey est **donné dans l'énoncé** (ce n'est jamais la
// bonne réponse) — la bonne réponse est l'artiste ou le groupe qui a
// enregistré la toute première version, souvent inconnu du grand public.
// Pas de lien automatique vers une fiche pour les propositions : la plupart
// des artistes originaux ici (Shocking Blue, les Valentine Brothers, Harold
// Melvin & The Blue Notes...) ne sont pas diffusés sur Radio Odyssey et
// n'ont donc pas de fiche sur le site. En revanche, chaque question renvoie
// vers la fiche de l'artiste réellement diffusé — le lien utile ici.
//
// ⚠️ Recherche menée titre par titre dans les 522 titres réels du catalogue
// (`artists.js`), pas de mémoire : plusieurs pistes plausibles ont été
// vérifiées puis écartées faute de confirmation (Bob Sinclar "I Feel For
// You" n'a aucun rapport avec le standard de Prince/Chaka Khan malgré le
// titre identique ; "Take Me To Your Heart" de Rick Astley et "Put A Little
// Love On Me" de Delegation sont bien des originaux, pas des reprises).
// Cinq pistes du propriétaire ont donné les meilleures trouvailles :
// "Comme Caroline" de Zaho reprend bien "Caroline" de MC Solaar (1991),
// "Toutes les femmes de ta vie" de Julien Doré (qu'on aurait pu croire
// originale) reprend en réalité le tube 2001 du groupe L5 — extrait de son
// album de reprises "Imposteur" (2024) —, "San Francisco" de Sound Of
// Legend (2026) reprend le classique hippie de Scott McKenzie (1967),
// "Paradise" de DJ Snake (2025) reprend "Another Day In Paradise" de Phil
// Collins (1989), et "Forever Young" de David Guetta (avec Ava Max, 2024)
// reprend le tube 1984 du groupe allemand Alphaville — ce dernier titre
// n'apparaît pas encore dans `artists.js` (fenêtre de l'export RadioKing
// non à jour) mais le propriétaire a confirmé sa diffusion réelle ; il n'a
// donc pas été ajouté à `tracks` (ce champ ne se saisit qu'au rapport,
// jamais à la main), seulement à ce quiz, qui est un contenu édité comme
// les fiches Découvertes. Une autre piste avancée pour "Coco Câline" (un
// possible original de Lio) n'a pas été confirmée : la chanson est bien un
// original de Julien Doré (2017), donc écartée.
//
// Conséquence assumée sur la taille du quiz : le réservoir de reprises
// réellement identifiables dans le catalogue est plus mince que pour les
// autres formats. Plutôt que de forcer 20 questions avec des pistes
// fragiles, ce premier lot s'arrête à 12 questions vérifiées, sans round
// bonus — voir la FAQ. Un artiste diffusé n'apparaît qu'une fois, à
// l'exception assumée de Jimmy Somerville (deux reprises distinctes,
// aucun conflit possible puisque les bonnes réponses — les originaux —
// sont différentes).
const questions = [
  {
    titre: "Venus",
    artiste: 'bananarama',
    nomArtiste: 'Bananarama',
    correct: 'Shocking Blue',
    annee: '1969',
    choices: ['Shocking Blue', 'Sister Sledge', 'Diana Ross', 'The Supremes'],
  },
  {
    titre: "Somethin' Stupid",
    artiste: 'robbie-williams',
    nomArtiste: 'Robbie Williams (avec Nicole Kidman)',
    correct: 'Frank et Nancy Sinatra',
    annee: '1967',
    choices: ['Frank et Nancy Sinatra', 'Dean Martin', 'Tony Bennett', 'Sammy Davis Jr.'],
  },
  {
    titre: "Don't Leave Me This Way",
    artiste: 'jimmy-somerville',
    nomArtiste: 'Jimmy Somerville',
    correct: 'Harold Melvin & The Blue Notes',
    annee: '1975',
    choices: ['Harold Melvin & The Blue Notes', 'The Stylistics', 'The Delfonics', 'The Temptations'],
  },
  {
    titre: "You Make Me Feel (Mighty Real)",
    artiste: 'jimmy-somerville',
    nomArtiste: 'Jimmy Somerville',
    correct: 'Sylvester',
    annee: '1978',
    choices: ['Sylvester', 'Grace Jones', 'Village People', 'Boney M.'],
  },
  {
    titre: "Money's Too Tight (To Mention)",
    artiste: 'simply-red',
    nomArtiste: 'Simply Red',
    correct: 'The Valentine Brothers',
    annee: '1982',
    choices: ['The Valentine Brothers', 'The Isley Brothers', 'Kool & The Gang', 'The Whispers'],
  },
  {
    titre: "Lady Marmalade",
    artiste: 'christina-aguilera',
    nomArtiste: 'Christina Aguilera',
    correct: 'Labelle',
    annee: '1974',
    choices: ['Labelle', 'Diana Ross', 'Donna Summer', 'Gloria Gaynor'],
  },
  {
    titre: "Unchain My Heart",
    artiste: 'joe-cocker',
    nomArtiste: 'Joe Cocker',
    correct: 'Ray Charles',
    annee: '1961',
    choices: ['Ray Charles', 'Otis Redding', 'Sam Cooke', 'Wilson Pickett'],
  },
  {
    titre: "Comme Caroline",
    artiste: 'zaho',
    nomArtiste: 'Zaho (avec MC Solaar)',
    correct: 'MC Solaar',
    annee: '1991',
    choices: ['MC Solaar', 'IAM', 'NTM', 'Doc Gynéco'],
  },
  {
    titre: "Toutes les femmes de ta vie",
    artiste: 'julien-dore',
    nomArtiste: 'Julien Doré',
    correct: 'L5',
    annee: '2001',
    choices: ['L5', '2Be3', 'Alliage', 'Il Était Une Fois'],
  },
  {
    titre: "San Francisco",
    artiste: 'sound-of-legend',
    nomArtiste: 'Sound Of Legend',
    correct: 'Scott McKenzie',
    annee: '1967',
    choices: ['Scott McKenzie', 'The Mamas & The Papas', 'Simon & Garfunkel', 'Peter, Paul and Mary'],
  },
  {
    titre: "Paradise",
    artiste: 'dj-snake',
    nomArtiste: 'DJ Snake (avec Bipolar Sunshine)',
    correct: 'Phil Collins',
    annee: '1989',
    choices: ['Phil Collins', 'Sting', 'Peter Gabriel', 'George Michael'],
  },
  {
    titre: "Forever Young",
    artiste: 'david-guetta',
    nomArtiste: 'David Guetta',
    correct: 'Alphaville',
    annee: '1984',
    choices: ['Alphaville', 'Depeche Mode', 'A-ha', 'Duran Duran'],
  },
];

const faq = [
  {
    q: 'En quoi ce quiz est-il différent des neuf autres ?',
    a: "Les neuf premiers quiz demandent de reconnaître l'artiste ou une année. Ici, l'artiste diffusé sur Radio Odyssey est donné dans la question — c'est l'artiste ou le groupe qui a créé le titre à l'origine qu'il faut retrouver, souvent bien moins connu que la version qu'on entend sur l'antenne.",
  },
  {
    q: 'Pourquoi ce quiz n\'a-t-il pas de round bonus ?',
    a: "Parce que le catalogue réel de Radio Odyssey ne contient pas encore 20 reprises identifiables avec certitude. Plusieurs pistes plausibles ont été vérifiées puis écartées faute de preuve solide, plutôt que d'être forcées dans le quiz. Douze questions vérifiées valent mieux que vingt approximatives — un round bonus rejoindra ce quiz si de nouvelles reprises apparaissent dans la programmation.",
  },
  {
    q: 'Ces reprises sont-elles vraiment diffusées sur Radio Odyssey ?',
    a: "Oui : les versions citées dans les questions (Bananarama, Robbie Williams, Jimmy Somerville, Simply Red, Christina Aguilera, Joe Cocker, Zaho, Julien Doré, Sound Of Legend, DJ Snake, David Guetta) sont toutes de vrais titres de notre catalogue — voir notre page <a href='/artistes-diffuses-radio-odyssey.html' style='color:var(--ro-purple);font-weight:700;'>artistes diffusés</a>. Les artistes originaux, eux, ne sont pas nécessairement présents sur l'antenne.",
  },
  {
    q: 'Les artistes originaux sont-ils vérifiés ?',
    a: "Chacun a été confirmé individuellement par recherche web avant d'être retenu. Cinq pistes du propriétaire ont directement mené à cinq des douze questions : « Comme Caroline » de Zaho (reprise de MC Solaar), « Toutes les femmes de ta vie » de Julien Doré (reprise du groupe L5, extrait de son album de reprises « Imposteur »), « San Francisco » de Sound Of Legend (reprise de Scott McKenzie, 1967), « Paradise » de DJ Snake (reprise de « Another Day In Paradise », Phil Collins, 1989) et « Forever Young » de David Guetta (reprise du groupe allemand Alphaville, 1984).",
  },
  {
    q: 'Puis-je refaire le quiz ?',
    a: "Oui, un bouton \"Recommencer\" est disponible à la fin — l'ordre des questions et des propositions change à chaque tentative.",
  },
];
---
<Layout
  lang="fr"
  title="Quiz « Artiste ou Groupe Original » | Radio Odyssey"
  description="Radio Odyssey diffuse parfois une reprise. Sauriez-vous retrouver l'artiste ou le groupe qui a chanté l'original ? 12 questions vérifiées, catalogue réel."
>
  <PageHero
    gradientFrom="#FF9A3C"
    gradientTo="#00C6FF"
    homeLabel="🏠 Accueil"
    breadcrumbCurrent="Quiz « Artiste ou groupe original »"
    title="Quiz « Artiste ou Groupe Original »"
    text="La version diffusée sur Radio Odyssey n'est pas toujours l'originale. Sauriez-vous retrouver qui a vraiment créé le titre ?"
  >
    <Fragment slot="icon">
      <svg viewBox="0 0 48 48" fill="none"><circle cx="18" cy="30" r="7" stroke="white" stroke-width="2.3"/><circle cx="34" cy="24" r="7" stroke="white" stroke-width="2.3"/><path d="M25 30V14L41 10V26" stroke="white" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    </Fragment>
  </PageHero>

  <main class="ro-section" data-pagefind-body>
    <div class="container">
      <div class="row gy-4">
        <div class="col-lg-8">

          <div class="content-card">
            <p style="margin:0;">Radio Odyssey diffuse parfois une <strong>reprise</strong> plutôt qu'un original — sans toujours le préciser. Ce quiz retourne la question posée par les neuf premiers : ici, l'artiste que vous entendez sur l'antenne est donné, et c'est <strong>l'artiste ou le groupe qui a chanté le titre en premier</strong> qu'il faut deviner. {questions.length} questions vérifiées une par une par recherche web, construites à partir du catalogue réellement diffusé sur <a href="/quiz-musicaux-radio-odyssey.html" style="color:var(--ro-purple);font-weight:700;">Radio Odyssey</a>.</p>
          </div>

          <div class="content-card" id="quizorig">
            <div id="quizorig-progress" style="font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#7B2FBE;margin-bottom:.8rem;">Question 1/{questions.length}</div>

            {questions.map((q, i) => (
              <div class="quizorig-q" data-index={i} style={i === 0 ? '' : 'display:none;'}>
                <p style="font-size:1.15rem;font-weight:800;color:var(--ro-dark);margin-bottom:.4rem;">🎵 Radio Odyssey diffuse « {q.titre} » par <strong>{q.nomArtiste}</strong> — quel artiste ou groupe l'avait chanté à l'origine, en {q.annee} ?</p>
                <p style="margin:0 0 1rem;font-size:.85rem;">
                  <a href={`/artiste-${q.artiste}.html`} style="color:var(--ro-purple);font-weight:700;">→ Découvrir {q.nomArtiste} sur Radio Odyssey</a>
                </p>
                <div style="display:flex;flex-direction:column;gap:.6rem;">
                  {q.choices.map((c) => (
                    <button
                      type="button"
                      class="quizorig-choice"
                      data-choice={c}
                      data-correct={c === q.correct ? 'true' : 'false'}
                      style="text-align:left;padding:.8rem 1rem;border-radius:12px;border:1.5px solid rgba(123,47,190,.2);background:rgba(123,47,190,.03);font-family:'Nunito',sans-serif;font-weight:700;color:var(--ro-dark);cursor:pointer;transition:background .15s,border-color .15s;width:100%;"
                    >
                      <span class="quizorig-choice-icon"></span>{c}
                    </button>
                  ))}
                </div>
                <p class="quizorig-feedback" style="display:none;margin:.8rem 0 0;font-weight:800;"></p>
                <button type="button" class="quizorig-next btn-hero-ghost" style="margin-top:.8rem;display:none;">Question suivante →</button>
              </div>
            ))}

            <div id="quizorig-results" style="display:none;">
              <p style="font-size:1.3rem;font-weight:900;color:var(--ro-purple);text-align:center;margin-bottom:.3rem;">Votre score : <span id="quizorig-score">0</span>/<span id="quizorig-max">{questions.length}</span></p>
              <p id="quizorig-verdict" style="text-align:center;color:var(--ro-muted);margin-bottom:1.5rem;"></p>
              <div style="display:flex;justify-content:center;">
                <button type="button" id="quizorig-restart" class="btn-hero">Recommencer</button>
              </div>
              <NewsletterCapture context="quiz" />
            </div>
          </div>

          <FAQBlock items={faq} idPrefix="quizorigfaq" />

          <RelatedPages
            alsoLike={[
              { href: '/quiz-musicaux-radio-odyssey.html', label: 'Tous nos Quiz Musicaux', desc: 'Les neuf autres quiz du site' },
              { href: '/quiz-coulisses-artistes-radio-odyssey.html', label: 'Quiz des Coulisses', desc: "Qui se cache derrière ce titre ? Un esprit voisin" },
              { href: '/artistes-diffuses-radio-odyssey.html', label: 'Tous les Artistes Diffusés', desc: 'Les fiches de chaque artiste cité dans ce quiz' },
              { href: '/comment-radio-odyssey-utilise-les-remix.html', label: 'Comment Radio Odyssey utilise les remix', desc: 'Remix, reprise : la différence expliquée' },
            ]}
            associated={[
              { href: '/styles-musicaux-radio-odyssey.html', label: 'Styles musicaux sur Radio Odyssey' },
              { href: '/comment-radio-odyssey-choisit-sa-musique.html', label: 'Comment Radio Odyssey choisit sa musique' },
              { href: '/musique-et-energie.html', label: 'Tout le cocon Musique & Énergie' },
            ]}
          />

          <div class="page-cta-bar">
            <h3>Écoutez ces titres en direct</h3>
            <a href="#" onclick="roPlayNow(event)" class="btn-hero">
              <Icon name="broadcast-pin" /> Écouter Radio Odyssey
            </a>
          </div>

        </div>
        <div class="col-lg-4">
          <Sidebar />
        </div>
      </div>
    </div>
  </main>

  <style>
    .quizorig-choice:hover { background: rgba(123,47,190,.08); }
    .quizorig-choice.is-correct { background: rgba(56,161,105,.15) !important; border-color: #38a169 !important; }
    .quizorig-choice.is-wrong { background: rgba(220,38,38,.1) !important; border-color: #dc2626 !important; }
    .quizorig-choice:disabled { cursor: default; opacity: .85; }
  </style>

  <script is:inline>
  function quizorigInit() {
    var container = document.getElementById('quizorig');
    if (!container) return;

    var qEls = Array.prototype.slice.call(container.querySelectorAll('.quizorig-q'));

    function shuffledOrder(n) {
      var order = [];
      for (var k = 0; k < n; k++) order.push(k);
      for (var i = order.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = order[i]; order[i] = order[j]; order[j] = tmp;
      }
      return order;
    }

    var order = shuffledOrder(qEls.length);
    var pos = 0;
    var score = 0;
    var pendingTimer = null;

    function hideAllScreens() {
      qEls.forEach(function (q) { q.style.display = 'none'; });
      var results = document.getElementById('quizorig-results');
      if (results) results.style.display = 'none';
    }

    function showQuestion(logicalPos) {
      hideAllScreens();
      var target = qEls[order[logicalPos]];
      if (target) target.style.display = '';
      var progress = document.getElementById('quizorig-progress');
      if (progress) {
        progress.style.display = '';
        progress.textContent = 'Question ' + (logicalPos + 1) + '/' + qEls.length;
      }
    }

    function showResults() {
      hideAllScreens();
      var progress = document.getElementById('quizorig-progress');
      if (progress) progress.style.display = 'none';
      var results = document.getElementById('quizorig-results');
      var scoreEl = document.getElementById('quizorig-score');
      var maxEl = document.getElementById('quizorig-max');
      var verdictEl = document.getElementById('quizorig-verdict');
      if (typeof roUmamiTrack === 'function') roUmamiTrack('quiz_complete', { quiz: 'quiz-artiste-original-radio-odyssey', round: 'main', score: score, max: qEls.length });
      if (scoreEl) scoreEl.textContent = String(score);
      if (maxEl) maxEl.textContent = String(qEls.length);
      if (verdictEl) {
        var msg = score === qEls.length
          ? "Score parfait ! Vous connaissez les originaux mieux que les reprises."
          : score >= Math.ceil(qEls.length * 0.7)
          ? "Très fort ! Peu de monde remonte aussi loin dans l'histoire de ces titres."
          : score >= Math.ceil(qEls.length * 0.4)
          ? "Pas mal ! Les reprises cachent bien leur jeu."
          : "Il est temps de creuser — chaque reprise a une histoire à découvrir.";
        verdictEl.textContent = msg;
      }
      if (results) results.style.display = '';
    }

    function advance() {
      if (pendingTimer) { clearTimeout(pendingTimer); pendingTimer = null; }
      pos += 1;
      if (pos < qEls.length) {
        showQuestion(pos);
        return;
      }
      showResults();
    }

    function shuffleChoices(qEl) {
      var wrap = qEl.querySelector('.quizorig-choice');
      wrap = wrap && wrap.parentElement;
      if (!wrap) return;
      var buttons = Array.prototype.slice.call(wrap.children);
      for (var i = buttons.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = buttons[i]; buttons[i] = buttons[j]; buttons[j] = tmp;
      }
      buttons.forEach(function (b) { wrap.appendChild(b); });
    }

    function wireQuestion(qEl) {
      shuffleChoices(qEl);
      var buttons = Array.prototype.slice.call(qEl.querySelectorAll('.quizorig-choice'));
      var nextBtn = qEl.querySelector('.quizorig-next');
      var feedback = qEl.querySelector('.quizorig-feedback');
      var answered = false;

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (answered) return;
          answered = true;
          var isCorrect = btn.getAttribute('data-correct') === 'true';
          var correctBtn = buttons.filter(function (b) { return b.getAttribute('data-correct') === 'true'; })[0];

          if (isCorrect) {
            score += 1;
            btn.classList.add('is-correct');
            btn.querySelector('.quizorig-choice-icon').textContent = '✅ ';
            if (feedback) {
              feedback.textContent = '✅ Bonne réponse !';
              feedback.style.color = '#38a169';
            }
          } else {
            btn.classList.add('is-wrong');
            btn.querySelector('.quizorig-choice-icon').textContent = '❌ ';
            if (correctBtn) {
              correctBtn.classList.add('is-correct');
              correctBtn.querySelector('.quizorig-choice-icon').textContent = '✅ ';
            }
            if (feedback) {
              feedback.textContent = '❌ Raté, la bonne réponse était surlignée en vert.';
              feedback.style.color = '#dc2626';
            }
          }
          if (feedback) feedback.style.display = '';
          buttons.forEach(function (b) { b.disabled = true; });
          if (nextBtn) nextBtn.style.display = 'inline-block';

          // Avance automatiquement après un court délai — l'utilisateur
          // peut aussi cliquer "Question suivante" pour ne pas attendre.
          pendingTimer = setTimeout(advance, 1600);
        });
      });

      if (nextBtn) {
        nextBtn.addEventListener('click', advance);
      }
    }

    qEls.forEach(wireQuestion);

    var restartBtn = document.getElementById('quizorig-restart');
    if (restartBtn) {
      restartBtn.addEventListener('click', function () {
        window.location.reload();
      });
    }

    showQuestion(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', quizorigInit);
  } else {
    quizorigInit();
  }
  </script>
</Layout>
