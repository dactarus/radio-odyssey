---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Sidebar from '../components/Sidebar.astro';
import FAQBlock from '../components/FAQBlock.astro';
import RelatedPages from '../components/RelatedPages.astro';

// Même principe que les quiz années 80, 90 et 2000 : chaque artiste/
// groupe n'apparaît qu'une seule fois comme bonne réponse sur tout le
// quiz (round principal + round bonus confondus), et chaque titre a été
// vérifié individuellement par recherche web pour confirmer une sortie
// réelle dans les années 2010.
const mainQuestions = [
  { track: "Shape of You", correct: 'ed-sheeran', choices: [
    { slug: 'shawn-mendes', name: 'Shawn Mendes' },
    { slug: 'ed-sheeran', name: 'Ed Sheeran' },
    { slug: 'lewis-capaldi', name: 'Lewis Capaldi' },
    { slug: 'calvin-harris', name: 'Calvin Harris' },
  ]},
  { track: "Chandelier", correct: 'sia', choices: [
    { slug: 'rihanna', name: 'Rihanna' },
    { slug: 'dua-lipa', name: 'Dua Lipa' },
    { slug: 'sia', name: 'Sia' },
    { slug: 'taylor-swift', name: 'Taylor Swift' },
  ]},
  { track: "We Found Love", correct: 'rihanna', choices: [
    { slug: 'sia', name: 'Sia' },
    { slug: 'taylor-swift', name: 'Taylor Swift' },
    { slug: 'rihanna', name: 'Rihanna' },
    { slug: 'dua-lipa', name: 'Dua Lipa' },
  ]},
  { track: "Titanium", correct: 'david-guetta', choices: [
    { slug: 'calvin-harris', name: 'Calvin Harris' },
    { slug: 'avicii', name: 'Avicii' },
    { slug: 'robin-schulz', name: 'Robin Schulz' },
    { slug: 'david-guetta', name: 'David Guetta' },
  ]},
  { track: "Cruel Summer", correct: 'taylor-swift', choices: [
    { slug: 'dua-lipa', name: 'Dua Lipa' },
    { slug: 'sia', name: 'Sia' },
    { slug: 'rihanna', name: 'Rihanna' },
    { slug: 'taylor-swift', name: 'Taylor Swift' },
  ]},
  { track: "Don't Start Now", correct: 'dua-lipa', choices: [
    { slug: 'taylor-swift', name: 'Taylor Swift' },
    { slug: 'rihanna', name: 'Rihanna' },
    { slug: 'ava-max', name: 'Ava Max' },
    { slug: 'dua-lipa', name: 'Dua Lipa' },
  ]},
  { track: "This Is What You Came For", correct: 'calvin-harris', choices: [
    { slug: 'david-guetta', name: 'David Guetta' },
    { slug: 'avicii', name: 'Avicii' },
    { slug: 'robin-schulz', name: 'Robin Schulz' },
    { slug: 'calvin-harris', name: 'Calvin Harris' },
  ]},
  { track: "Wake Me Up", correct: 'avicii', choices: [
    { slug: 'calvin-harris', name: 'Calvin Harris' },
    { slug: 'david-guetta', name: 'David Guetta' },
    { slug: 'avicii', name: 'Avicii' },
    { slug: 'robin-schulz', name: 'Robin Schulz' },
  ]},
  { track: "There's Nothing Holdin' Me Back", correct: 'shawn-mendes', choices: [
    { slug: 'ed-sheeran', name: 'Ed Sheeran' },
    { slug: 'lewis-capaldi', name: 'Lewis Capaldi' },
    { slug: 'shawn-mendes', name: 'Shawn Mendes' },
    { slug: 'jain', name: 'Jain' },
  ]},
  { track: "Someone You Loved", correct: 'lewis-capaldi', choices: [
    { slug: 'ed-sheeran', name: 'Ed Sheeran' },
    { slug: 'shawn-mendes', name: 'Shawn Mendes' },
    { slug: 'sia', name: 'Sia' },
    { slug: 'lewis-capaldi', name: 'Lewis Capaldi' },
  ]},
];

const bonusQuestions = [
  { track: "Sugar", correct: 'robin-schulz', choices: [
    { slug: 'kungs', name: 'Kungs' },
    { slug: 'ofenbach', name: 'Ofenbach' },
    { slug: 'lost-frequencies', name: 'Lost Frequencies' },
    { slug: 'robin-schulz', name: 'Robin Schulz' },
  ]},
  { track: "Papaoutai", correct: 'stromae', choices: [
    { slug: 'jain', name: 'Jain' },
    { slug: 'the-avener', name: 'The Avener' },
    { slug: 'ofenbach', name: 'Ofenbach' },
    { slug: 'stromae', name: 'Stromae' },
  ]},
  { track: "Be Mine", correct: 'ofenbach', choices: [
    { slug: 'kungs', name: 'Kungs' },
    { slug: 'robin-schulz', name: 'Robin Schulz' },
    { slug: 'lost-frequencies', name: 'Lost Frequencies' },
    { slug: 'ofenbach', name: 'Ofenbach' },
  ]},
  { track: "This Girl", correct: 'kungs', choices: [
    { slug: 'ofenbach', name: 'Ofenbach' },
    { slug: 'robin-schulz', name: 'Robin Schulz' },
    { slug: 'dj-snake', name: 'DJ Snake' },
    { slug: 'kungs', name: 'Kungs' },
  ]},
  { track: "Makeba", correct: 'jain', choices: [
    { slug: 'stromae', name: 'Stromae' },
    { slug: 'the-avener', name: 'The Avener' },
    { slug: 'clean-bandit', name: 'Clean Bandit' },
    { slug: 'jain', name: 'Jain' },
  ]},
  { track: "Fade Out Lines", correct: 'the-avener', choices: [
    { slug: 'jain', name: 'Jain' },
    { slug: 'stromae', name: 'Stromae' },
    { slug: 'moby', name: 'Moby' },
    { slug: 'the-avener', name: 'The Avener' },
  ]},
  { track: "Rockabye", correct: 'clean-bandit', choices: [
    { slug: 'ava-max', name: 'Ava Max' },
    { slug: 'jain', name: 'Jain' },
    { slug: 'kungs', name: 'Kungs' },
    { slug: 'clean-bandit', name: 'Clean Bandit' },
  ]},
  { track: "Sweet But Psycho", correct: 'ava-max', choices: [
    { slug: 'clean-bandit', name: 'Clean Bandit' },
    { slug: 'dua-lipa', name: 'Dua Lipa' },
    { slug: 'taylor-swift', name: 'Taylor Swift' },
    { slug: 'ava-max', name: 'Ava Max' },
  ]},
  { track: "Are You With Me", correct: 'lost-frequencies', choices: [
    { slug: 'robin-schulz', name: 'Robin Schulz' },
    { slug: 'kungs', name: 'Kungs' },
    { slug: 'dj-snake', name: 'DJ Snake' },
    { slug: 'lost-frequencies', name: 'Lost Frequencies' },
  ]},
  { track: "Loco Contigo", correct: 'dj-snake', choices: [
    { slug: 'lost-frequencies', name: 'Lost Frequencies' },
    { slug: 'kungs', name: 'Kungs' },
    { slug: 'ofenbach', name: 'Ofenbach' },
    { slug: 'dj-snake', name: 'DJ Snake' },
  ]},
];

const TOTAL_ARTISTS = mainQuestions.length + bonusQuestions.length;

const faq = [
  { q: 'Les titres de ce quiz sont-ils vraiment diffusés sur Radio Odyssey ?', a: "Oui, tous les titres et artistes de ce quiz font partie de notre catalogue réel de programmation — voir notre page <a href='/artistes-diffuses-radio-odyssey.html' style='color:var(--ro-purple);font-weight:700;'>artistes diffusés</a>." },
  { q: 'Le quiz a-t-il un niveau de difficulté ?', a: "Le round principal réunit des tubes très connus internationalement ; le round bonus va chercher des titres plus difficiles à trouver, du côté de la scène dance/électro française et belge." },
  { q: 'Qu\'est-ce que le round bonus ?', a: "Réussir un score parfait sur les 10 questions du round principal débloque 10 questions bonus supplémentaires, pour un score final possible sur 20." },
  { q: 'Puis-je refaire le quiz ?', a: "Oui, un bouton \"Recommencer\" est disponible à la fin pour retenter votre chance — l'ordre des questions change à chaque tentative." },
];
---
<Layout
  lang="fr"
  title="Quiz Musical Années 2010 | Radio Odyssey"
  description="Testez vos connaissances avec ce quiz musical années 2010, basé sur les vrais titres diffusés sur Radio Odyssey. Un round bonus si score parfait."
>
  <PageHero
    gradientFrom="#7B2FBE"
    gradientTo="#FF3CAC"
    homeLabel="🏠 Accueil"
    breadcrumbCurrent="Quiz musical années 2010"
    title="Quiz Musical Années 2010"
    text="10 questions, basées sur les vrais titres diffusés sur Radio Odyssey — et 10 de plus si vous faites un sans-faute."
  >
    <Fragment slot="icon">
      <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="18" stroke="white" stroke-width="2.3"/><path d="M24 14V24L31 28" stroke="white" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M17 8L12 13M31 8L36 13" stroke="rgba(255,255,255,.6)" stroke-width="2" stroke-linecap="round"/></svg>
    </Fragment>
  </PageHero>

  <main class="ro-section" data-pagefind-body>
    <div class="container">
      <div class="row gy-4">
        <div class="col-lg-8">

          <div class="content-card">
            <p style="margin:0;">Après les <a href="/quiz-musical-annees-80.html" style="color:var(--ro-purple);font-weight:700;">années 80</a>, les <a href="/quiz-musical-annees-90.html" style="color:var(--ro-purple);font-weight:700;">années 90</a> et les <a href="/quiz-musical-annees-2000.html" style="color:var(--ro-purple);font-weight:700;">années 2000</a>, place aux années 2010 ! Voici {mainQuestions.length} questions basées sur les vrais titres diffusés sur Radio Odyssey — chaque artiste n'apparaît qu'une seule fois, et chaque titre est vérifié comme étant réellement sorti dans les années 2010. Un sans-faute débloque {bonusQuestions.length} questions bonus !</p>
          </div>

          <div class="content-card" id="quiz2010">
            <div id="quiz2010-progress" style="font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#7B2FBE;margin-bottom:.8rem;">Question 1/{mainQuestions.length}</div>

            {mainQuestions.map((q, i) => (
              <div class="quiz2010-q" data-round="main" data-index={i} style={i === 0 ? '' : 'display:none;'}>
                <p style="font-size:1.15rem;font-weight:800;color:var(--ro-dark);margin-bottom:1rem;">🎵 "{q.track}"</p>
                <div style="display:flex;flex-direction:column;gap:.6rem;">
                  {q.choices.map((c) => (
                    <button
                      type="button"
                      class="quiz2010-choice"
                      data-slug={c.slug}
                      data-correct={c.slug === q.correct ? 'true' : 'false'}
                      style="text-align:left;padding:.8rem 1rem;border-radius:12px;border:1.5px solid rgba(123,47,190,.2);background:rgba(123,47,190,.03);font-family:'Nunito',sans-serif;font-weight:700;color:var(--ro-dark);cursor:pointer;transition:background .15s,border-color .15s;width:100%;"
                    >
                      <span class="quiz2010-choice-icon"></span>{c.name}
                    </button>
                  ))}
                </div>
                <p class="quiz2010-feedback" style="display:none;margin:.8rem 0 0;font-weight:800;"></p>
                <button type="button" class="quiz2010-next btn-hero-ghost" style="margin-top:.8rem;display:none;">Question suivante →</button>
              </div>
            ))}

            {bonusQuestions.map((q, i) => (
              <div class="quiz2010-q" data-round="bonus" data-index={i} style="display:none;">
                <p style="font-size:1.15rem;font-weight:800;color:var(--ro-dark);margin-bottom:1rem;">🎁 🎵 "{q.track}"</p>
                <div style="display:flex;flex-direction:column;gap:.6rem;">
                  {q.choices.map((c) => (
                    <button
                      type="button"
                      class="quiz2010-choice"
                      data-slug={c.slug}
                      data-correct={c.slug === q.correct ? 'true' : 'false'}
                      style="text-align:left;padding:.8rem 1rem;border-radius:12px;border:1.5px solid rgba(255,215,0,.35);background:rgba(255,215,0,.05);font-family:'Nunito',sans-serif;font-weight:700;color:var(--ro-dark);cursor:pointer;transition:background .15s,border-color .15s;width:100%;"
                    >
                      <span class="quiz2010-choice-icon"></span>{c.name}
                    </button>
                  ))}
                </div>
                <p class="quiz2010-feedback" style="display:none;margin:.8rem 0 0;font-weight:800;"></p>
                <button type="button" class="quiz2010-next btn-hero-ghost" style="margin-top:.8rem;display:none;">Question suivante →</button>
              </div>
            ))}

            <div id="quiz2010-bonus-offer" style="display:none;text-align:center;">
              <p style="font-size:1.4rem;margin-bottom:.3rem;">🎉 Score parfait !</p>
              <p style="color:var(--ro-muted);margin-bottom:1.3rem;">Vous débloquez {bonusQuestions.length} questions bonus. Score final possible : {TOTAL_ARTISTS}/{TOTAL_ARTISTS}.</p>
              <div style="display:flex;flex-wrap:wrap;gap:.8rem;justify-content:center;">
                <button type="button" id="quiz2010-bonus-start" class="btn-hero">🎁 Tenter le bonus</button>
                <button type="button" id="quiz2010-bonus-skip" class="btn-hero-ghost">Voir mon score</button>
              </div>
            </div>

            <div id="quiz2010-results" style="display:none;">
              <p style="font-size:1.3rem;font-weight:900;color:var(--ro-purple);text-align:center;margin-bottom:.3rem;">Votre score : <span id="quiz2010-score">0</span>/<span id="quiz2010-max">{mainQuestions.length}</span></p>
              <p id="quiz2010-verdict" style="text-align:center;color:var(--ro-muted);margin-bottom:1.5rem;"></p>
              <div style="display:flex;justify-content:center;">
                <button type="button" id="quiz2010-restart" class="btn-hero">Recommencer</button>
              </div>
            </div>
          </div>

          <FAQBlock items={faq} idPrefix="quiz2010faq" />

          <RelatedPages
            alsoLike={[
              { href: '/quiz-musical-annees-2000.html', label: 'Quiz Musical Années 2000', desc: 'Le même défi, une décennie plus tôt' },
              { href: '/quiz-musical-annees-90.html', label: 'Quiz Musical Années 90', desc: 'Le même défi, deux décennies plus tôt' },
              { href: '/titres-les-plus-diffuses-sur-radio-odyssey.html', label: 'Les Titres les Plus Diffusés', desc: 'Le classement réel, tous styles confondus' },
            ]}
            associated={[
              { href: '/artistes-diffuses-radio-odyssey.html', label: 'Tous les artistes diffusés' },
              { href: '/styles-musicaux-radio-odyssey.html', label: 'Styles musicaux sur Radio Odyssey' },
              { href: '/musique-et-energie.html', label: 'Tout le cocon Musique & Énergie' },
            ]}
          />

          <div class="page-cta-bar">
            <h3>Écoutez ces titres en direct</h3>
            <a href="#" onclick="roPlayNow(event)" class="btn-hero">
              <Icon name="broadcast-pin" /> Écouter Radio Odyssey
            </a>
          </div>

        </div>
        <div class="col-lg-4">
          <Sidebar />
        </div>
      </div>
    </div>
  </main>

  <style>
    .quiz2010-choice:hover { background: rgba(123,47,190,.08); }
    .quiz2010-choice.is-correct { background: rgba(56,161,105,.15) !important; border-color: #38a169 !important; }
    .quiz2010-choice.is-wrong { background: rgba(220,38,38,.1) !important; border-color: #dc2626 !important; }
    .quiz2010-choice:disabled { cursor: default; opacity: .85; }
  </style>

  <script is:inline>
  function quiz2010Init() {
    var container = document.getElementById('quiz2010');
    if (!container) return;

    var mainEls = Array.prototype.slice.call(container.querySelectorAll('.quiz2010-q[data-round="main"]'));
    var bonusEls = Array.prototype.slice.call(container.querySelectorAll('.quiz2010-q[data-round="bonus"]'));
    var totalArtists = mainEls.length + bonusEls.length;

    function shuffledOrder(n) {
      var order = [];
      for (var k = 0; k < n; k++) order.push(k);
      for (var i = order.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = order[i]; order[i] = order[j]; order[j] = tmp;
      }
      return order;
    }

    var mainOrder = shuffledOrder(mainEls.length);
    var bonusOrder = shuffledOrder(bonusEls.length);

    var phase = 'main'; // 'main' | 'bonus' | 'done'
    var pos = 0;
    var score = 0;
    var pendingTimer = null;

    function currentEls() { return phase === 'bonus' ? bonusEls : mainEls; }
    function currentOrder() { return phase === 'bonus' ? bonusOrder : mainOrder; }

    function hideAllScreens() {
      mainEls.concat(bonusEls).forEach(function (q) { q.style.display = 'none'; });
      var offer = document.getElementById('quiz2010-bonus-offer');
      if (offer) offer.style.display = 'none';
      var results = document.getElementById('quiz2010-results');
      if (results) results.style.display = 'none';
    }

    function showQuestion(logicalPos) {
      hideAllScreens();
      var els = currentEls();
      var order = currentOrder();
      var target = els[order[logicalPos]];
      if (target) target.style.display = '';
      var progress = document.getElementById('quiz2010-progress');
      if (progress) {
        progress.style.display = '';
        var label = phase === 'bonus' ? '🎁 Bonus — Question ' : 'Question ';
        progress.textContent = label + (logicalPos + 1) + '/' + els.length;
      }
    }

    function showBonusOffer() {
      hideAllScreens();
      var progress = document.getElementById('quiz2010-progress');
      if (progress) progress.style.display = 'none';
      var offer = document.getElementById('quiz2010-bonus-offer');
      if (offer) offer.style.display = '';
    }

    function showResults() {
      hideAllScreens();
      var progress = document.getElementById('quiz2010-progress');
      if (progress) progress.style.display = 'none';
      var results = document.getElementById('quiz2010-results');
      var scoreEl = document.getElementById('quiz2010-score');
      var maxEl = document.getElementById('quiz2010-max');
      var verdictEl = document.getElementById('quiz2010-verdict');
      var max = phase === 'bonus' ? totalArtists : mainEls.length;
      if (scoreEl) scoreEl.textContent = String(score);
      if (maxEl) maxEl.textContent = String(max);
      if (verdictEl) {
        var msg;
        if (max === totalArtists && bonusEls.length > 0 && phase === 'bonus') {
          msg = score === totalArtists
            ? "Score absolument parfait, sur les deux rounds !"
            : score >= Math.ceil(totalArtists * 0.7)
            ? "Très fort sur ce format complet !"
            : "Belle tentative — vous connaissez déjà bien les années 2010 !";
        } else if (score === mainEls.length) {
          msg = "Score parfait ! (Vous avez choisi de ne pas tenter le bonus.)";
        } else {
          msg = score >= Math.ceil(mainEls.length * 0.7)
            ? "Incollable ! Les années 2010 n'ont plus aucun secret pour vous."
            : score >= Math.ceil(mainEls.length * 0.4)
            ? "Pas mal ! Encore quelques tubes à réviser."
            : "Il est temps de réviser en musique — tentez à nouveau votre chance !";
        }
        verdictEl.textContent = msg;
      }
      if (results) results.style.display = '';
    }

    function advance() {
      if (pendingTimer) { clearTimeout(pendingTimer); pendingTimer = null; }
      pos += 1;
      var els = currentEls();
      if (pos < els.length) {
        showQuestion(pos);
        return;
      }
      // Fin du round en cours.
      if (phase === 'main') {
        if (score === mainEls.length && bonusEls.length > 0) {
          showBonusOffer();
        } else {
          showResults();
        }
      } else {
        showResults();
      }
    }

    function wireQuestion(qEl) {
      var buttons = Array.prototype.slice.call(qEl.querySelectorAll('.quiz2010-choice'));
      var nextBtn = qEl.querySelector('.quiz2010-next');
      var feedback = qEl.querySelector('.quiz2010-feedback');
      var answered = false;

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (answered) return;
          answered = true;
          var isCorrect = btn.getAttribute('data-correct') === 'true';
          var correctBtn = buttons.filter(function (b) { return b.getAttribute('data-correct') === 'true'; })[0];

          if (isCorrect) {
            score += 1;
            btn.classList.add('is-correct');
            btn.querySelector('.quiz2010-choice-icon').textContent = '✅ ';
            if (feedback) {
              feedback.textContent = '✅ Bonne réponse !';
              feedback.style.color = '#38a169';
            }
          } else {
            btn.classList.add('is-wrong');
            btn.querySelector('.quiz2010-choice-icon').textContent = '❌ ';
            if (correctBtn) {
              correctBtn.classList.add('is-correct');
              correctBtn.querySelector('.quiz2010-choice-icon').textContent = '✅ ';
            }
            if (feedback) {
              feedback.textContent = '❌ Raté, la bonne réponse était surlignée en vert.';
              feedback.style.color = '#dc2626';
            }
          }
          if (feedback) feedback.style.display = '';
          buttons.forEach(function (b) { b.disabled = true; });
          if (nextBtn) nextBtn.style.display = 'inline-block';

          // Avance automatiquement après un court délai — l'utilisateur
          // peut aussi cliquer "Question suivante" pour ne pas attendre.
          pendingTimer = setTimeout(advance, 1600);
        });
      });

      if (nextBtn) {
        nextBtn.addEventListener('click', advance);
      }
    }

    mainEls.forEach(wireQuestion);
    bonusEls.forEach(wireQuestion);

    var bonusStartBtn = document.getElementById('quiz2010-bonus-start');
    if (bonusStartBtn) {
      bonusStartBtn.addEventListener('click', function () {
        phase = 'bonus';
        pos = 0;
        showQuestion(0);
      });
    }

    var bonusSkipBtn = document.getElementById('quiz2010-bonus-skip');
    if (bonusSkipBtn) {
      bonusSkipBtn.addEventListener('click', function () {
        showResults();
      });
    }

    var restartBtn = document.getElementById('quiz2010-restart');
    if (restartBtn) {
      restartBtn.addEventListener('click', function () {
        window.location.reload();
      });
    }

    showQuestion(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', quiz2010Init);
  } else {
    quiz2010Init();
  }
  </script>
</Layout>
