---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import NowPlaying from '../components/NowPlaying.astro';
import QuizInvite from '../components/QuizInvite.astro';
import { NAV_CATEGORIES } from '../data/navigation.js';

const title = 'Radio Odyssey – Web Radio Bien-être & Bonne Humeur 24h/24';
const description = "Radio Odyssey, votre web radio 100% positive ! Hits des années 80, dance, easy listening, cohérence cardiaque. Gratuite, sans pub, non-stop 24h/24.";

// Les neuf quiz mis en avant sur l'accueil (§98 : neuvième quiz ajouté).
// Ordre choisi : les décennies d'abord (les plus jouées et les plus
// recherchées), puis les trois quiz sur l'univers de la radio, puis le
// quiz transversal, le plus récent.
const QUIZ_ACCUEIL = [
  { href: '/quiz-musical-annees-80.html', nom: 'Années 80', sous: 'Le plus joué' },
  { href: '/quiz-musical-annees-90.html', nom: 'Années 90', sous: 'Eurodance & ballades' },
  { href: '/quiz-musical-annees-2000.html', nom: 'Années 2000', sous: 'Le tournant électro' },
  { href: '/quiz-musical-annees-2010.html', nom: 'Années 2010', sous: 'La décennie streaming' },
  { href: '/quiz-musical-annees-2020.html', nom: 'Années 2020', sous: 'La décennie en cours' },
  { href: '/quiz-noms-artistes-radio-odyssey.html', nom: 'Noms de scène', sous: "D'où vient ce surnom ?" },
  { href: '/quiz-records-radio-odyssey.html', nom: 'Records', sous: 'Qui détient cet exploit ?' },
  { href: '/quiz-coulisses-artistes-radio-odyssey.html', nom: 'Coulisses', sous: 'Qui se cache derrière ?' },
  { href: '/quiz-cette-annee-la-radio-odyssey.html', nom: 'Cette année-là', sous: "L'artiste est donné, à vous l'année" },
];
const ogTitle = 'Radio Odyssey – Positive Web Radio';
const ogDescription = "Web radio musicale positive en streaming 24h/24. Joyeuse, bien-être, gratuite.";
---
<Layout lang="fr" altLangs={{ fr: '/', en: '/en.html' }} title={title} description={description} ogTitle={ogTitle} ogDescription={ogDescription} ogImage="/assets/images/og/home.jpg">
  <Fragment slot="head">
  <style is:global>
    /* ── SVG icon wrappers ── */
    .svg-icon {
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .svg-icon svg { width: 100%; height: 100%; display: block; }

    /* Feature card icon circles */
    .fc-icon {
      width: 72px; height: 72px; border-radius: 50%;
      margin: 0 auto 1.2rem;
      display: flex; align-items: center; justify-content: center;
    }
    .fc-icon svg { width: 40px; height: 40px; }

    /* Page card icon */
    .pg-icon { width: 52px; height: 52px; border-radius: 14px; }
    .pg-icon svg { width: 28px; height: 28px; }

    /* Schedule icon */
    .schedule-icon svg { width: 28px; height: 28px; }

    /* Social icon */
    .social-btn svg { width: 22px; height: 22px; flex-shrink: 0; }

    /* Hero CTA row */
    .hero-cta { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-bottom: .5rem; }

    /* Hero : sous-titre H1 + paragraphe SEO */
    .hero-subtitle {
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      color: #fff;
      opacity: .92;
      letter-spacing: .01em;
      margin: -.5rem 0 1.1rem;
      text-shadow: 0 1px 8px rgba(0,0,0,.2);
    }
    .hero-seo-text {
      font-size: .95rem;
      line-height: 1.7;
      color: rgba(255,255,255,.8);
      max-width: 560px;
      margin-top: 1.5rem;
    }

    /* Grille des programmes — chaque créneau renvoie vers sa page dédiée */
    a.schedule-row { text-decoration: none; color: inherit; }
    a.schedule-row .schedule-arrow { margin-left: auto; color: var(--ro-purple); opacity: .45; transition: opacity .2s, transform .2s; flex-shrink: 0; }
    a.schedule-row:hover .schedule-arrow { opacity: 1; transform: translateX(3px); }

    /* ── ESPACE SOUS LA BARRE LECTEUR (desktop) ─────────────────────
       Le lecteur natif tient dans --bar-h (105px). L'ancienne valeur
       de 190px compensait le débordement de l'iframe RadioKing ; elle
       laisserait aujourd'hui un vide de 85px sous la barre.
    ─────────────────────────────────────────────────────────────── */
    body {
      padding-top: calc(var(--bar-h) + 20px);
    }
    html {
      scroll-padding-top: calc(var(--bar-h) + 20px);
    }

    /* ── BARRE LECTEUR MOBILE COMPACTE ─────────────────────────────
       Le lecteur lui-même est stylé dans RadioPlayer.astro.
       Ici : uniquement les overrides propres à la page d'accueil
    ─────────────────────────────────────────────────────────────── */
    @media (max-width: 767px) {
      /* Barre compacte 62px */
      #topRadioBar {
        height: 62px !important;
        padding: 0 8px !important;
        gap: 8px !important;
      }
      body {
        padding-top: 62px !important;
      }
      html {
        scroll-padding-top: 60px !important;
      }
      .bar-logo { margin-left: 0; }
      .bar-logo-img {
        width: 42px !important;
        height: 42px !important;
      }
      .bar-burger {
        width: 36px !important;
        height: 36px !important;
        font-size: 1.2rem !important;
        margin-right: 0 !important;
      }
    }
  </style>
  </Fragment>

<main data-pagefind-body style="display:contents;">

{/* ============================================================
     HERO
     ============================================================ */}
<section class="hero">
  <div class="hero-bubble hero-bubble-1"></div>
  <div class="hero-bubble hero-bubble-2"></div>
  <div class="container">
    <div class="row align-items-center gy-5">

      <div class="col-lg-7 hero-content">
        <div class="hero-eyebrow">
          <span class="hero-live-dot"></span>
          EN DIRECT &nbsp;·&nbsp; LIVE NOW
        </div>
        <h1>Radio Odyssey<br/><em>La Positive Radio !</em></h1>
        <p class="hero-subtitle">Musique positive • Bien-être • Cohérence cardiaque</p>
        <p class="tagline">
          Le meilleur des hits — des années 80 à aujourd'hui, non-stop 24h/24<br/>
          <span style="font-size:.92rem;opacity:.85;font-style:italic;">
            The best hits — from the 80s to today, non-stop 24/7
          </span>
        </p>
        <div class="hero-cta">
          <a href="#" onclick="roPlayNow(event)" class="btn-hero">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/></svg>
            ÉCOUTER EN DIRECT
          </a>
          <a href="https://app.radio-odyssey.com/" target="_blank" rel="noopener" class="btn-hero-ghost">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            App Mobile
          </a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat">24/7<span>Musique non-stop</span></div>
          <div class="hero-stat">80's<span>Tubes remixés</span></div>
          <div class="hero-stat">100%<span>Gratuit &amp; positif</span></div>
          <div class="hero-stat">0<span>Publicités</span></div>
        </div>
        <a href="/elisabeth-belot-grimaud-radio-odyssey.html" style="display:inline-flex;align-items:center;gap:.5rem;margin-top:1.4rem;text-decoration:none;background:var(--ro-gold);border:1px solid rgba(0,0,0,.06);border-radius:999px;padding:.42rem 1.2rem;font-family:'Nunito',sans-serif;font-weight:800;font-size:.82rem;letter-spacing:.02em;color:#2D2D3A;box-shadow:0 6px 20px rgba(0,0,0,.18);">
          <Icon name="patch-check-fill" style="color:var(--ro-purple);" />
          Cohérence cardiaque conçue avec une Docteure en psychologie
        </a>
        <p class="hero-seo-text">
          Radio Odyssey est une web radio positive gratuite qui associe musique et bien-être&nbsp;:
          hits des années 80 remixés, dance énergisante, easy listening et nouveautés se mêlent
          à des séquences de cohérence cardiaque diffusées chaque heure, sans aucune publicité.
          Que vous cherchiez une radio pour vous détendre, une musique pour vous concentrer au
          travail ou simplement une programmation joyeuse pour toute la famille, Radio Odyssey
          vous accompagne 24h/24 et 7j/7, sur mobile, en voiture ou sur enceinte connectée.
          Découvrez une nouvelle façon d'écouter la radio&nbsp;: positive, gratuite, et pensée
          pour votre équilibre au quotidien.
        </p>
      </div>

      <div class="col-lg-5 text-center">
        <picture>
          <source srcset="/assets/images/logo.webp" type="image/webp"/>
          <img class="hero-logo-img"
               src="/assets/images/logo.png"
               alt="Radio Odyssey" width="512" height="512"/>
        </picture>
      </div>
    </div>
  </div>
</section>

{/* ============================================================
     TITRES RÉCENTS — En ce moment sur Radio Odyssey
     ============================================================ */}
<NowPlaying />

{/* Surcharge CSS du widget RadioKing pour l'intégrer au thème sombre */}
<style is:global>
</style>



{/* ============================================================
     POURQUOI RADIO ODYSSEY EST DIFFÉRENTE — encart de mise en avant
     ============================================================ */}
<section class="ro-section">
  <div class="container">
    <a href="/pourquoi-radio-odyssey-est-differente.html" class="coherence-banner" style="display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem;justify-content:space-between;padding:1.8rem 2rem;text-decoration:none;background:linear-gradient(135deg,#7B2FBE,#FFD700);">
      <div style="flex:1;min-width:260px;">
        <span class="section-eyebrow" style="color:rgba(255,255,255,.85);">Notre différence</span>
        <h2 style="margin:.3rem 0 .5rem;color:#fff;-webkit-text-fill-color:#fff;">Pourquoi Radio Odyssey est <span style="text-decoration:underline;text-decoration-color:rgba(255,255,255,.5);">différente</span> ?</h2>
        <p style="margin:0;font-size:.92rem;opacity:.92;color:#fff;">
          Association loi 1901, sans publicité, une voix humaine plutôt qu'une IA — découvrez notre mission et nos choix, en quelques minutes.
        </p>
      </div>
      <span class="btn-ro" style="flex-shrink:0;">
        <Icon name="patch-check-fill" />&nbsp;Découvrir notre différence
      </span>
    </a>
  </div>
</section>

{/* ============================================================
     COHERENCE CARDIAQUE — bandeau compact
     ============================================================ */}
<section class="ro-section ro-section-alt">
  <div class="container">
    <div class="coherence-banner" style="padding:1.8rem 2rem;display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem;justify-content:space-between;">
      <div style="flex:1;min-width:260px;">
        <span class="section-eyebrow">Exclusivité Radio Odyssey</span>
        <h2 style="margin:.3rem 0 .5rem;">Cohérence Cardiaque <span class="highlight">chaque heure !</span></h2>
        <p style="margin:0;font-size:.92rem;opacity:.92;">
          <Icon name="lungs" /> Inspirez 5 secondes, expirez 5 secondes, au rythme de la musique — des séquences courtes toute la journée.
        </p>
        <a href="/elisabeth-belot-grimaud-radio-odyssey.html" style="display:inline-flex;align-items:center;gap:.5rem;margin-top:.9rem;background:var(--ro-gold);color:#2D2D3A;padding:.45rem 1.1rem;border-radius:999px;font-family:'Nunito',sans-serif;font-weight:800;font-size:.82rem;text-decoration:none;box-shadow:0 4px 16px rgba(0,0,0,.18);">
          <Icon name="patch-check-fill" style="color:var(--ro-purple);" />
          Conçues avec Elisabeth Bélot-Grimaud, Docteure en psychologie — notre partenaire exclusive
        </a>
      </div>
      <a href="radio-coherence-cardiaque.html" class="btn-ro" style="flex-shrink:0;">
        <Icon name="arrow-right-circle-fill" />&nbsp;En savoir plus
      </a>
    </div>
  </div>
</section>

{/* ============================================================
     QUIZ MUSICAUX — invitation à jouer
     ------------------------------------------------------------
     Placé juste après le bandeau cohérence cardiaque, mais
     volontairement plus léger que les deux encarts qui précèdent :
     trois bandeaux pleine largeur d'affilée feraient mur. Fond
     blanc, une seule ligne de titre, les neuf quiz listés en
     pastilles cliquables — on entre dans le jeu, on ne lit pas un
     argumentaire de plus.

     Motif : avant ce bloc, l'accueil ne contenait aucun lien vers
     un quiz. Les huit pages d'origine ne vivaient que du référencement,
     alors que /quiz-musical-annees-80.html est déjà la 3e page la plus
     consultée du site.
     ============================================================ */}
<section class="ro-section" style="padding-top:2.4rem;padding-bottom:2.4rem;">
  <div class="container">
    <QuizInvite href="/quiz-musicaux-radio-odyssey.html" quiz={QUIZ_ACCUEIL} boutonNombre={9} />
  </div>
</section>

{/* ============================================================
     CATÉGORIES — TOUTES NOS PAGES
     ============================================================ */}
<section class="ro-section">
  <div class="container">
    <div class="text-center mb-5">
      <span class="section-eyebrow">Explorez Radio Odyssey</span>
      <h2>Toutes nos <span class="highlight">thématiques</span></h2>
      <p class="text-muted mt-2" style="max-width:500px;margin:0 auto;font-size:.93rem;">
        De la cohérence cardiaque à la dance énergisante, trouvez exactement ce dont vous avez besoin.
      </p>
    </div>

    <div class="row g-4">
      {NAV_CATEGORIES.map((cat) => (
        <div class="col-md-6 col-lg-4">
          <a class="page-card" href={cat.hub} style="flex-direction:column;align-items:flex-start;text-align:left;padding:1.8rem;">
            <div class="pg-icon svg-icon" style={`width:64px;height:64px;background:${cat.iconBg};margin-bottom:1rem;`} set:html={cat.icon}>
            </div>
            <div>
              <h3 style="font-size:1.05rem;">{cat.tileLabel || cat.label}</h3>
              <p>{cat.hubIntro}</p>
              <p style="color:var(--ro-purple);font-weight:700;font-size:.82rem;margin-top:.6rem;">
                {cat.pages.length} page{cat.pages.length > 1 ? 's' : ''} <Icon name="arrow-right" />
              </p>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ============================================================
     PLANNING — aperçu compact, détail sur Playlists du Jour
     ============================================================ */}
<section class="ro-section ro-section-alt">
  <div class="container">
    <div class="text-center mb-4">
      <span class="section-eyebrow">Grille des programmes</span>
      <h2>Une semaine <span class="highlight">toujours rythmée</span></h2>
    </div>
    <div class="d-flex flex-wrap justify-content-center gap-2">
      <a class="schedule-row" href="/musique-pour-le-reveil.html" style="flex:0 1 auto;padding:.6rem 1rem;border-radius:999px;background:rgba(255,255,255,.6);">
        <strong style="color:var(--ro-purple);">7–9H</strong> La Matinale <Icon name="chevron-right" class="schedule-arrow" />
      </a>
      <a class="schedule-row" href="/playlist-pour-la-matinee.html" style="flex:0 1 auto;padding:.6rem 1rem;border-radius:999px;background:rgba(255,255,255,.6);">
        <strong style="color:var(--ro-purple);">9–12H</strong> Hits Non-Stop <Icon name="chevron-right" class="schedule-arrow" />
      </a>
      <a class="schedule-row" href="/musique-pour-la-pause-dejeuner.html" style="flex:0 1 auto;padding:.6rem 1rem;border-radius:999px;background:rgba(255,255,255,.6);">
        <strong style="color:var(--ro-purple);">12–14H</strong> Respirez en Musique <Icon name="chevron-right" class="schedule-arrow" />
      </a>
      <a class="schedule-row" href="/musique-pour-lapres-midi.html" style="flex:0 1 auto;padding:.6rem 1rem;border-radius:999px;background:rgba(255,255,255,.6);">
        <strong style="color:var(--ro-purple);">14–18H</strong> Easy Listening <Icon name="chevron-right" class="schedule-arrow" />
      </a>
      <a class="schedule-row" href="/musique-pour-laperitif.html" style="flex:0 1 auto;padding:.6rem 1rem;border-radius:999px;background:rgba(255,255,255,.6);">
        <strong style="color:var(--ro-purple);">18–21H</strong> Mix du Soir <Icon name="chevron-right" class="schedule-arrow" />
      </a>
      <a class="schedule-row" href="/musique-pour-la-nuit.html" style="flex:0 1 auto;padding:.6rem 1rem;border-radius:999px;background:rgba(255,255,255,.6);">
        <strong style="color:var(--ro-purple);">21H–7H</strong> Nuit <Icon name="chevron-right" class="schedule-arrow" />
      </a>
    </div>
    <p class="text-center mt-3" style="margin-bottom:0;">
      <a href="/playlists-du-jour.html" style="color:var(--ro-purple);font-weight:700;font-size:.88rem;text-decoration:none;">
        Voir la grille détaillée <Icon name="arrow-right" />
      </a>
    </p>
  </div>
</section>


{/* ============================================================
     AVIS — invitation honnête, pas de témoignages fabriqués
     ============================================================ */}
<section class="ro-section" style="padding-top:2rem;padding-bottom:2rem;">
  <div class="container text-center">
    <p style="font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--ro-muted);margin-bottom:.6rem;">Votre avis compte</p>
    <p style="font-size:.92rem;color:var(--ro-muted);max-width:480px;margin:0 auto 1rem;">
      Radio Odyssey est une radio indépendante — vos retours nous aident directement à améliorer la programmation.
    </p>
    <a href="/avis-radio-odyssey-bien-etre.html" style="color:var(--ro-purple);font-weight:700;font-size:.82rem;text-decoration:none;">
      Partager mon avis <Icon name="arrow-right" />
    </a>
  </div>
</section>


{/* ============================================================
     PLATEFORMES + APP — fusionné, condensé
     ============================================================ */}
<section class="ro-section ro-section-alt">
  <div class="container">
    <div class="text-center mb-4">
      <span class="section-eyebrow">Reconnue par les plateformes</span>
      <h2>Écoutez où vous voulez</h2>
      <p class="text-muted mt-2" style="max-width:560px;margin:0 auto;font-size:.93rem;">
        Une radio indépendante référencée sur les plus grandes plateformes d'écoute — pas seulement sur son propre site.
      </p>
    </div>
    <div class="d-flex flex-wrap justify-content-center gap-3 mb-3">
      <a class="platform-pill" href="https://link.radioking.com/radio-odyssey" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="14" height="14" rx="3" stroke="#7B2FBE" stroke-width="1.5"/><polygon points="6,5 6,11 12,8" fill="#7B2FBE"/></svg>RadioKing</a>
      <a class="platform-pill" href="https://tunein.com/radio/RADIO-ODYSSEY-s339104/" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8C3 5.2 5.2 3 8 3C10.8 3 13 5.2 13 8" stroke="#FF3CAC" stroke-width="1.5" stroke-linecap="round"/><path d="M5 8C5 6.3 6.3 5 8 5C9.7 5 11 6.3 11 8" stroke="#FF9A3C" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="8" r="1.5" fill="#FF3CAC"/></svg>TuneIn</a>
      <a class="platform-pill" href="https://www.deezer.com/search/radio%20odyssey/livestream" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="7" width="3" height="6" rx="1" fill="#FF9A3C"/><rect x="5" y="5" width="3" height="8" rx="1" fill="#FF3CAC"/><rect x="9" y="3" width="3" height="10" rx="1" fill="#7B2FBE"/><rect x="13" y="1" width="2" height="12" rx="1" fill="#00C6FF"/></svg>Deezer</a>
      <a class="platform-pill" href="https://radio.orange.com/radios/radio_odyssey" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="#FF9A3C" stroke-width="1.5" fill="none"/><circle cx="8" cy="8" r="3" fill="#FF9A3C" opacity=".3"/></svg>Orange</a>
      <a class="platform-pill" href="https://fr.welove.radio/radio/radio-odyssey/" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 13C8 13 2 9 2 5.5C2 3.6 3.6 2 5.5 2C6.4 2 8 3 8 3C8 3 9.6 2 10.5 2C12.4 2 14 3.6 14 5.5C14 9 8 13 8 13Z" stroke="#FF3CAC" stroke-width="1.5" fill="none"/></svg>WeLoveRadio</a>
      <a class="platform-pill" href="https://mytuner-radio.com/fr/radio/radio-odyssey-512057/" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="#FF9A3C" stroke-width="1.5"/><circle cx="8" cy="8" r="2" stroke="#7B2FBE" stroke-width="1.3"/></svg>MyTuner</a>
      <a class="platform-pill" href="https://www.radioline.co/fr/radios/radio_odyssey" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><line x1="2" y1="4" x2="14" y2="4" stroke="#7B2FBE" stroke-width="1.5" stroke-linecap="round"/><line x1="2" y1="8" x2="14" y2="8" stroke="#FF3CAC" stroke-width="1.5" stroke-linecap="round"/><line x1="2" y1="12" x2="14" y2="12" stroke="#00C6FF" stroke-width="1.5" stroke-linecap="round"/></svg>RadioLine</a>
      <a class="platform-pill" href="https://radio.menu/stations/radio-odyssey-mobirisesite-com-radio-odyssey/" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="3" stroke="#00C6FF" stroke-width="1.5"/><line x1="4.5" y1="6" x2="11.5" y2="6" stroke="#00C6FF" stroke-width="1.5" stroke-linecap="round"/><line x1="4.5" y1="9" x2="9.5" y2="9" stroke="#7B2FBE" stroke-width="1.5" stroke-linecap="round"/></svg>Radio.menu</a>
    </div>
    <p class="text-center" style="font-size:.85rem;color:var(--ro-muted);margin-bottom:0;">
      Aussi sur Streema, GetMeRadio, RadioFM et bien d'autres — et sur <strong>Alexa</strong> : <em>"Alexa, lance Radio Odyssey sur TuneIn"</em>.
      <br/>
      <a href="https://app.radio-odyssey.com/" target="_blank" rel="noopener" style="color:var(--ro-purple);font-weight:700;text-decoration:none;">
        <Icon name="phone" /> Installer l'app mobile
