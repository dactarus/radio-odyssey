---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Sidebar from '../components/Sidebar.astro';
import FAQBlock from '../components/FAQBlock.astro';
import RelatedPages from '../components/RelatedPages.astro';
import ContentIllustration from '../components/ContentIllustration.astro';
import { ARTISTS } from '../data/artists.js';
import { GENRE_FAMILIES, artistsForFamily } from '../data/genres.js';

const family = GENRE_FAMILIES.find((f) => f.slug === 'radio-pop-rock-en-ligne');
const artists = artistsForFamily(family, ARTISTS).sort((a, b) => b.playCount - a.playCount);

const faq = [
  { q: 'Radio Odyssey diffuse-t-elle du rock ?', a: `Oui, sous un angle pop/rock plutôt que rock pur et dur : ${artists.length} artistes de notre catalogue mélangent guitares et refrains accessibles, de Queen à Coldplay en passant par Mylène Farmer.` },
  { q: "C'est plutôt du rock ou de la pop ?", a: "Un peu des deux : cette page réunit les artistes dont le style oscille entre pop et rock — des refrains mélodiques, mais avec de vraies guitares et une énergie plus rock que la pop pure." },
  { q: 'Y a-t-il aussi du rock français ?', a: "Oui, Indochine et Mylène Farmer font partie de cette sélection — deux références du rock/pop francophone, aux côtés des grands noms internationaux du genre." },
];
---
<Layout
  lang="fr"
  title="Radio Pop/Rock en Ligne Gratuite | Radio Odyssey"
  description={`Une radio pop/rock en ligne, gratuite et sans publicité : ${artists.length} artistes réellement diffusés sur Radio Odyssey, de Queen à Coldplay.`}
>
  <PageHero
    gradientFrom="#1e7fcb"
    gradientTo="#7B2FBE"
    homeLabel="🏠 Accueil"
    breadcrumbCurrent="Radio Pop/Rock en Ligne Gratuite"
    title="Radio Pop/Rock en Ligne"
    text={`${artists.length} artistes pop/rock réellement diffusés, sur une radio associative gratuite et sans publicité.`}
  >
    <Fragment slot="icon">
      <svg viewBox="0 0 48 48" fill="none"><path d="M14 34L34 14" stroke="white" stroke-width="2.3" stroke-linecap="round"/><circle cx="16" cy="32" r="5" stroke="white" stroke-width="2.3"/><circle cx="32" cy="16" r="5" stroke="rgba(255,255,255,.7)" stroke-width="2"/></svg>
    </Fragment>
  </PageHero>

  <main class="ro-section" data-pagefind-body>
    <div class="container">
      <div class="row gy-4">
        <div class="col-lg-8">

          <div class="content-card">
            <h2>Quand la pop rencontre les guitares</h2>
            <p>Entre les refrains mélodiques et les guitares plus affirmées, {artists.length} artistes pop/rock font partie de la programmation de Radio Odyssey — de références installées comme Queen, U2 ou Elton John à des voix plus actuelles comme Damiano David (Måneskin) ou Harry Styles.</p>
          </div>

          <div class="content-card">
            <h2>Les artistes pop/rock diffusés sur l'antenne</h2>
            <p style="margin-bottom:1rem;">Classés par fréquence de passage réelle — cliquez sur un nom pour voir ses titres diffusés :</p>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
              {artists.map((a) => (
                <a href={`/artiste-${a.slug}.html`} class="tag-pill" style="text-decoration:none;">{a.name}</a>
              ))}
            </div>
          </div>

          <ContentIllustration gradientFrom="#1e7fcb" gradientTo="#7B2FBE" caption="Des guitares et des refrains qui traversent les générations.">
            <Fragment slot="icon">
              <svg viewBox="0 0 48 48" fill="none"><path d="M14 34L34 14" stroke="white" stroke-width="2.3" stroke-linecap="round"/><circle cx="16" cy="32" r="5" stroke="white" stroke-width="2.3"/><circle cx="32" cy="16" r="5" stroke="rgba(255,255,255,.7)" stroke-width="2"/></svg>
            </Fragment>
          </ContentIllustration>

          <div class="content-card">
            <h2>Une énergie plus posée, jamais criarde</h2>
            <p>Le pop/rock apporte un supplément d'intensité à l'antenne, sans jamais tomber dans l'agressivité — une énergie qui reste positive, à l'image du reste de la programmation. Découvrez aussi notre <a href="/radio-pop-en-ligne.html" style="color:var(--ro-purple);font-weight:700;">radio pop</a> ou notre sélection <a href="/radio-dance-electro-en-ligne.html" style="color:var(--ro-purple);font-weight:700;">dance & électro</a>.</p>
          </div>

          <FAQBlock items={faq} idPrefix="rprock" />

          <RelatedPages
            alsoLike={[
              { href: '/radio-pop-en-ligne.html', label: 'Radio Pop en Ligne', desc: 'La pop internationale sur Radio Odyssey' },
              { href: '/radio-pop-rnb-en-ligne.html', label: 'Radio Pop/R&B en Ligne', desc: 'Groove, soul et voix puissantes' },
              { href: '/artistes-diffuses-radio-odyssey.html', label: 'Tous les artistes diffusés', desc: "L'ensemble du catalogue, tous styles confondus" },
            ]}
            associated={[
              { href: '/styles-musicaux-radio-odyssey.html', label: 'Tous les styles musicaux' },
              { href: '/artistes-et-styles.html', label: 'Le cocon Artistes & Styles' },
              { href: '/radio-pop-francaise-en-ligne.html', label: 'Radio Pop Française' },
            ]}
          />

          <div class="page-cta-bar">
            <h3>Écoutez le pop/rock sans publicité</h3>
            <div style="display:flex;flex-wrap:wrap;gap:.8rem;justify-content:center;margin-top:1rem;">
              <a href="#" onclick="roPlayNow(event)" class="btn-hero">
                <Icon name="broadcast-pin" /> Écouter Radio Odyssey
              </a>
              <a href="https://app.radio-odyssey.com/" target="_blank" rel="noopener" class="btn-hero-ghost">
                <Icon name="phone" /> Télécharger l'application
              </a>
              <a href="/artistes-et-styles.html" class="btn-hero-ghost">
                <Icon name="grid" /> Découvrir les autres thèmes
              </a>
            </div>
          </div>

        </div>
        <div class="col-lg-4">
          <Sidebar />
        </div>
      </div>
    </div>
  </main>
</Layout>
