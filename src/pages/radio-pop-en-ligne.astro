---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Sidebar from '../components/Sidebar.astro';
import FAQBlock from '../components/FAQBlock.astro';
import RelatedPages from '../components/RelatedPages.astro';
import ContentIllustration from '../components/ContentIllustration.astro';
import { ARTISTS } from '../data/artists.js';
import { GENRE_FAMILIES, artistsForFamily } from '../data/genres.js';

const family = GENRE_FAMILIES.find((f) => f.slug === 'radio-pop-en-ligne');
const artists = artistsForFamily(family, ARTISTS).sort((a, b) => b.playCount - a.playCount);

const faq = [
  { q: 'Quels artistes pop entend-on le plus souvent sur Radio Odyssey ?', a: `Parmi les ${artists.length} artistes pop de notre programmation, on retrouve aussi bien des voix installées comme Madonna, Lady Gaga ou Robbie Williams que des noms plus récents comme Sabrina Carpenter ou Benson Boone — voir la liste complète ci-dessous, avec un lien vers la fiche de chaque artiste.` },
  { q: 'La pop est-elle le style principal de Radio Odyssey ?', a: "C'est la famille la plus représentée dans notre catalogue, mais Radio Odyssey mélange aussi la pop française, la dance/électro, le pop/rock et le pop/R&B tout au long de la journée — voir notre page sur tous les styles musicaux diffusés." },
  { q: 'Radio Odyssey diffuse-t-elle uniquement de la pop internationale ?', a: "Non. Cette page réunit les artistes classés \"Pop\" dans notre catalogue ; la chanson française a sa propre page dédiée, tout comme le pop/rock et le pop/R&B." },
];
---
<Layout
  lang="fr"
  title="Radio Pop en Ligne Gratuite | Radio Odyssey"
  description={`Écoutez une radio pop en ligne gratuite et sans publicité : ${artists.length} artistes pop réellement diffusés sur Radio Odyssey, de Madonna à Sabrina Carpenter.`}
>
  <PageHero
    gradientFrom="#FF3CAC"
    gradientTo="#7B2FBE"
    homeLabel="🏠 Accueil"
    breadcrumbCurrent="Radio Pop en Ligne Gratuite"
    title="Radio Pop en Ligne"
    text={`${artists.length} artistes pop réellement diffusés sur l'antenne, sur une radio associative gratuite et sans publicité.`}
  >
    <Fragment slot="icon">
      <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="10" r="5" stroke="white" stroke-width="2.3"/><path d="M24 15V30" stroke="white" stroke-width="2.3" stroke-linecap="round"/><path d="M14 30C14 33.3 18.5 36 24 36C29.5 36 34 33.3 34 30" stroke="white" stroke-width="2.3" stroke-linecap="round" fill="none"/><line x1="24" y1="36" x2="24" y2="41" stroke="white" stroke-width="2.3" stroke-linecap="round"/></svg>
    </Fragment>
  </PageHero>

  <main class="ro-section" data-pagefind-body>
    <div class="container">
      <div class="row gy-4">
        <div class="col-lg-8">

          <div class="content-card">
            <h2>Une radio pop, sans coupures publicitaires</h2>
            <p>La pop est la famille musicale la plus présente sur Radio Odyssey : {artists.length} artistes de notre catalogue y sont classés, des incontournables des années 2000 aux voix qui cartonnent aujourd'hui. Radio Odyssey reste une web radio associative — gratuite, sans publicité, financée par ses seuls auditeurs — ce qui laisse toute la place aux titres, sans interruption commerciale.</p>
          </div>

          <div class="content-card">
            <h2>Les artistes pop diffusés sur l'antenne</h2>
            <p style="margin-bottom:1rem;">Classés par fréquence de passage réelle sur l'antenne (données de programmation) — cliquez sur un nom pour voir ses titres diffusés :</p>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
              {artists.map((a) => (
                <a href={`/artiste-${a.slug}.html`} class="tag-pill" style="text-decoration:none;">{a.name}</a>
              ))}
            </div>
          </div>

          <ContentIllustration gradientFrom="#FF3CAC" gradientTo="#7B2FBE" caption="La pop, en fond sonore toute la journée, sans jamais de pub.">
            <Fragment slot="icon">
              <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="10" r="5" stroke="white" stroke-width="2.3"/><path d="M24 15V30" stroke="white" stroke-width="2.3" stroke-linecap="round"/><path d="M14 30C14 33.3 18.5 36 24 36C29.5 36 34 33.3 34 30" stroke="white" stroke-width="2.3" stroke-linecap="round" fill="none"/><line x1="24" y1="36" x2="24" y2="41" stroke="white" stroke-width="2.3" stroke-linecap="round"/></svg>
            </Fragment>
          </ContentIllustration>

          <div class="content-card">
            <h2>Une pop entrecoupée de respiration, pas de coupures pub</h2>
            <p>Sur Radio Odyssey, les titres pop s'enchaînent en direct 24h/24, avec un vrai contrepoint : nos séquences de <a href="/radio-coherence-cardiaque.html" style="color:var(--ro-purple);font-weight:700;">cohérence cardiaque</a>, glissées plusieurs fois par jour dans le flux musical. L'idée : garder l'énergie positive de la pop, sans jamais tomber dans le survoltage permanent.</p>
            <p>Envie d'un style plus précis ? Retrouvez aussi notre <a href="/radio-pop-francaise-en-ligne.html" style="color:var(--ro-purple);font-weight:700;">radio pop française</a>, notre sélection <a href="/radio-pop-rock-en-ligne.html" style="color:var(--ro-purple);font-weight:700;">pop/rock</a> et notre page <a href="/radio-pop-rnb-en-ligne.html" style="color:var(--ro-purple);font-weight:700;">pop/R&B</a>.</p>
          </div>

          <FAQBlock items={faq} idPrefix="rpop" />

          <RelatedPages
            alsoLike={[
              { href: '/radio-pop-rock-en-ligne.html', label: 'Radio Pop/Rock en Ligne', desc: 'Quand la pop rencontre les guitares' },
              { href: '/radio-pop-rnb-en-ligne.html', label: 'Radio Pop/R&B en Ligne', desc: 'Groove, soul et voix puissantes' },
              { href: '/radio-annees-80-en-ligne.html', label: 'Radio Années 80 en Ligne', desc: 'Les tubes pop des années 80, remixés' },
            ]}
            associated={[
              { href: '/artistes-diffuses-radio-odyssey.html', label: 'Tous les artistes diffusés' },
              { href: '/styles-musicaux-radio-odyssey.html', label: 'Tous les styles musicaux' },
              { href: '/artistes-et-styles.html', label: 'Le cocon Artistes & Styles' },
            ]}
          />

          <div class="page-cta-bar">
            <h3>Écoutez la pop sans publicité, en direct</h3>
            <div style="display:flex;flex-wrap:wrap;gap:.8rem;justify-content:center;margin-top:1rem;">
              <a href="#" onclick="roPlayNow(event)" class="btn-hero">
                <Icon name="broadcast-pin" /> Écouter Radio Odyssey
              </a>
              <a href="https://app.radio-odyssey.com/" target="_blank" rel="noopener" class="btn-hero-ghost">
                <Icon name="phone" /> Télécharger l'application
              </a>
              <a href="/artistes-et-styles.html" class="btn-hero-ghost">
                <Icon name="grid" /> Découvrir les autres thèmes
              </a>
            </div>
          </div>

        </div>
        <div class="col-lg-4">
          <Sidebar />
        </div>
      </div>
    </div>
  </main>
</Layout>
