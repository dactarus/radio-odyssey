---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Sidebar from '../components/Sidebar.astro';
import FAQBlock from '../components/FAQBlock.astro';
import RelatedPages from '../components/RelatedPages.astro';

const profils = [
  {
    emoji: '🌅',
    titre: 'Calmer son rythme, du réveil au coucher',
    desc: "Envie d'une journée qui commence et se termine en douceur ?",
    color: '#00C6FF',
    liens: [
      { href: '/musique-pour-le-reveil.html', label: 'Musique pour le Réveil' },
      { href: '/radio-detente-moderne.html', label: 'Radio Détente Moderne' },
      { href: '/coherence-cardiaque-pour-dormir.html', label: 'Cohérence Cardiaque pour Dormir' },
    ],
  },
  {
    emoji: '🕺',
    titre: 'Nostalgique et envie de danser',
    desc: 'Les tubes des années 80 remixés, la dance qui fait bouger.',
    color: '#FF3CAC',
    liens: [
      { href: '/radio-annees-80-en-ligne.html', label: 'Radio Années 80 en Ligne' },
      { href: '/radio-dance-energisante.html', label: 'Radio Dance Énergisante' },
      { href: '/radio-pop-en-ligne.html', label: 'Radio Pop en Ligne' },
    ],
  },
  {
    emoji: '💪',
    titre: 'De l\'énergie pour bouger',
    desc: 'Un flux qui tient la cadence, du premier échauffement au dernier kilomètre.',
    color: '#FF9A3C',
    liens: [
      { href: '/musique-pour-faire-du-sport.html', label: 'Musique pour Faire du Sport' },
      { href: '/musique-pour-courir.html', label: 'Musique pour Courir' },
      { href: '/coherence-cardiaque-et-sport.html', label: 'Cohérence Cardiaque et Sport' },
    ],
  },
  {
    emoji: '💻',
    titre: 'Se concentrer, au travail ou en révisant',
    desc: 'En fond sonore, sans coupure publicitaire pour casser la concentration.',
    color: '#1e7fcb',
    liens: [
      { href: '/radio-pour-travailler.html', label: 'Radio pour Travailler' },
      { href: '/musique-pour-se-concentrer.html', label: 'Musique pour se Concentrer' },
      { href: '/coherence-cardiaque-au-bureau.html', label: 'Cohérence Cardiaque au Bureau' },
    ],
  },
  {
    emoji: '🎤',
    titre: "Curieux de ce qui passe à l'antenne",
    desc: 'Qui on diffuse, comment on les choisit, et qui on met en avant.',
    color: '#7B2FBE',
    liens: [
      { href: '/artistes-diffuses-radio-odyssey.html', label: 'Artistes Diffusés' },
      { href: '/decouvertes-radio-odyssey.html', label: 'Découvertes Radio Odyssey' },
      { href: '/comment-radio-odyssey-choisit-sa-musique.html', label: 'Comment on Choisit la Musique' },
    ],
  },
  {
    emoji: '🎧',
    titre: "Écouter partout, sur n'importe quel appareil",
    desc: 'Mobile, voiture, enceinte connectée, TV, montre, ordinateur.',
    color: '#FFD700',
    liens: [
      { href: '/ecouter-radio-odyssey-sur-mobile.html', label: 'Sur Mobile' },
      { href: '/ecouter-radio-odyssey-en-voiture.html', label: 'En Voiture' },
      { href: '/ecouter-radio-odyssey-enceinte-connectee.html', label: 'Sur Enceinte Connectée' },
    ],
  },
];

const faq = [
  {
    q: "Ce guide couvre-t-il tout le contenu du site ?",
    a: "Non, c'est un point de départ, pas un plan du site exhaustif — pensé pour vous emmener vite là où vous avez envie d'aller. Pour tout explorer, direction le menu en haut de page, ou l'icône loupe pour rechercher directement un mot-clé.",
  },
  {
    q: "Et si je me reconnais dans plusieurs profils ?",
    a: "Tant mieux ! Rien n'empêche d'explorer plusieurs parcours à la fois — ce sont des points d'entrée, pas des cases.",
  },
  {
    q: "Ce guide remplace-t-il la page sur ce qui différencie Radio Odyssey ?",
    a: 'Non, les deux se complètent : <a href="/pourquoi-radio-odyssey-est-differente.html" style="color:var(--ro-purple);font-weight:700;">Pourquoi Radio Odyssey est différente</a> explique notre mission et nos choix ; ce guide, lui, vous emmène directement vers le contenu qui correspond à votre envie du moment.',
  },
];
---
<Layout
  lang="fr"
  title="Suivez le Guide : Découvrez Radio Odyssey en Quelques Minutes"
  description="Calme, énergie, concentration, nostalgie 80s : suivez le guide pour découvrir en quelques minutes les pages de Radio Odyssey faites pour vous."
  articleDatePublished="2026-07-27"
>
  <PageHero
    gradientFrom="#FF3CAC"
    gradientTo="#7B2FBE"
    homeLabel="🏠 Accueil"
    breadcrumbCurrent="Suivez le guide de Radio Odyssey"
    title="Suivez le Guide"
    text="Six façons d'entrer dans Radio Odyssey — choisissez celle qui vous correspond, là, maintenant."
  >
    <Fragment slot="icon">
      <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="17" stroke="white" stroke-width="2.3"/><path d="M30 18L26 26L18 30L22 22L30 18Z" stroke="white" stroke-width="2" stroke-linejoin="round" fill="rgba(255,255,255,.25)"/><circle cx="24" cy="24" r="1.6" fill="white"/></svg>
    </Fragment>
  </PageHero>

  <main class="ro-section" data-pagefind-body>
    <div class="container">
      <div class="row gy-4">
        <div class="col-lg-8">

          <div class="content-card">
            <p style="margin:0;">Radio Odyssey, c'est beaucoup de pages, beaucoup d'idées, beaucoup de musique. Plutôt que de tout lister, voici six façons d'entrer dans l'univers de la radio — repérez celle qui vous parle aujourd'hui, et suivez le guide.</p>
          </div>

          {profils.map((p) => (
            <div class="content-card">
              <h2 style={`color:${p.color};`}>{p.emoji} {p.titre}</h2>
              <p>{p.desc}</p>
              <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.8rem;">
                {p.liens.map((l) => (
                  <a href={l.href} class="tag-pill" style="text-decoration:none;">{l.label}</a>
                ))}
              </div>
            </div>
          ))}

          <FAQBlock items={faq} idPrefix="guide" />

          <RelatedPages
            alsoLike={[
              { href: '/pourquoi-radio-odyssey-est-differente.html', label: 'Pourquoi Radio Odyssey est Différente', desc: 'Notre mission et nos choix, en quelques minutes' },
              { href: '/bien-etre-et-sante.html', label: 'Tout le cocon Bien-être', desc: 'Musique positive, respiration et cohérence cardiaque' },
              { href: '/musique-et-energie.html', label: 'Tout le cocon Musique & Énergie', desc: "Des années 80 remixées à la dance la plus énergisante" },
            ]}
            associated={[
              { href: '/artistes-et-styles.html', label: 'Artistes & Styles' },
              { href: '/conseils-ecoute.html', label: "Conseils d'Écoute" },
              { href: '/faq-radio-odyssey.html', label: 'Questions Fréquentes' },
            ]}
          />

          <div class="page-cta-bar">
            <h3>Prêt à explorer ?</h3>
            <div style="display:flex;flex-wrap:wrap;gap:.8rem;justify-content:center;margin-top:1rem;">
              <a href="#" onclick="roPlayNow(event)" class="btn-hero">
                <Icon name="broadcast-pin" /> Écouter Radio Odyssey
              </a>
              <a href="/coulisses-de-radio-odyssey.html" class="btn-hero-ghost">
                <Icon name="film" /> Toutes les Coulisses
              </a>
            </div>
          </div>

        </div>
        <div class="col-lg-4">
          <Sidebar />
        </div>
      </div>
    </div>
  </main>
</Layout>
