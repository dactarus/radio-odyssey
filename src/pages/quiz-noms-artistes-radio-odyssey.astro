---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Sidebar from '../components/Sidebar.astro';
import FAQBlock from '../components/FAQBlock.astro';
import RelatedPages from '../components/RelatedPages.astro';
import QuizBlock from '../components/QuizBlock.astro';

// Quiz bâti sur les `facts` des fiches artistes (§64 à §68), tous vérifiés
// avant publication. Les réponses sont **immuables** : une date, un nom, un
// lieu, un record acquis — rien qui dépende de la programmation du moment.
// C'est la condition pour qu'un score reste comparable d'un mois à l'autre.
//
// Chaque artiste n'est bonne réponse qu'une seule fois dans ce quiz.
// `correct` porte le slug de la fiche : data/quiz-artistes.js s'en sert pour
// afficher le quiz sur la fiche de l'artiste concerné, sans aucune saisie.

const main = [
  { enonce: "Quel artiste doit son nom de scène à un acronyme signifiant « Someone Who Isn't Me, Sometimes » ?", correct: 'teddy-swims', choices: [
    { slug: "stromae", name: "Stromae" },
    { slug: "teddy-swims", name: "Teddy Swims" },
    { slug: "bob-sinclar", name: "Bob Sinclar" },
    { slug: "moby", name: "Moby" },
  ]},
  { enonce: "Quel artiste belge a pris pour nom le verlan de « maestro » ?", correct: 'stromae', choices: [
    { slug: "damiano-david", name: "Damiano David" },
    { slug: "teddy-swims", name: "Teddy Swims" },
    { slug: "lost-frequencies", name: "Lost Frequencies" },
    { slug: "stromae", name: "Stromae" },
  ]},
  { enonce: "Quel DJ français a emprunté son pseudonyme à un personnage du film Le Magnifique ?", correct: 'bob-sinclar', choices: [
    { slug: "the-avener", name: "The Avener" },
    { slug: "bob-sinclar", name: "Bob Sinclar" },
    { slug: "dj-snake", name: "DJ Snake" },
    { slug: "kungs", name: "Kungs" },
  ]},
  { enonce: "Quel chanteur britannique doit son surnom à un pull rayé jaune et noir qui le faisait ressembler à une abeille ?", correct: 'sting', choices: [
    { slug: "phil-collins", name: "Phil Collins" },
    { slug: "elton-john", name: "Elton John" },
    { slug: "sting", name: "Sting" },
    { slug: "rod-stewart", name: "Rod Stewart" },
  ]},
  { enonce: "Quel DJ suédois a pris pour nom le plus bas niveau de l'enfer dans le bouddhisme ?", correct: 'avicii', choices: [
    { slug: "avicii", name: "Avicii" },
    { slug: "calvin-harris", name: "Calvin Harris" },
    { slug: "r3hab", name: "R3HAB" },
    { slug: "robin-schulz", name: "Robin Schulz" },
  ]},
  { enonce: "Quel duo français porte le nom d'une critique de presse le qualifiant de « daft punky thrash » ?", correct: 'daft-punk', choices: [
    { slug: "ofenbach", name: "Ofenbach" },
    { slug: "modjo", name: "Modjo" },
    { slug: "the-avener", name: "The Avener" },
    { slug: "daft-punk", name: "Daft Punk" },
  ]},
  { enonce: "Quel groupe écossais a pris son nom du film Paris, Texas de Wim Wenders ?", correct: 'texas', choices: [
    { slug: "simply-red", name: "Simply Red" },
    { slug: "texas", name: "Texas" },
    { slug: "simple-minds", name: "Simple Minds" },
    { slug: "the-corrs", name: "The Corrs" },
  ]},
  { enonce: "Quel artiste américain doit son nom à un ancêtre supposé, l'auteur de Moby-Dick ?", correct: 'moby', choices: [
    { slug: "moby", name: "Moby" },
    { slug: "lizzo", name: "Lizzo" },
    { slug: "sting", name: "Sting" },
    { slug: "the-weeknd", name: "The Weeknd" },
  ]},
  { enonce: "Quel groupe britannique doit son nom à la chevelure rousse de son chanteur ?", correct: 'simply-red', choices: [
    { slug: "texas", name: "Texas" },
    { slug: "jamiroquai", name: "Jamiroquai" },
    { slug: "m-people", name: "M People" },
    { slug: "simply-red", name: "Simply Red" },
  ]},
  { enonce: "Quel projet britannique porte le nom de l'entraîneur du club de football de Crewe ?", correct: 'dario-g', choices: [
    { slug: "clean-bandit", name: "Clean Bandit" },
    { slug: "corona", name: "Corona" },
    { slug: "dario-g", name: "Dario G" },
    { slug: "m-people", name: "M People" },
  ]},
];

const bonus = [
  { enonce: "De quelle chanteuse le prénom de naissance, « Bleta », signifie-t-il « abeille » en albanais ?", correct: 'bebe-rexha', choices: [
    { slug: "dua-lipa", name: "Dua Lipa" },
    { slug: "ava-max", name: "Ava Max" },
    { slug: "bebe-rexha", name: "Bebe Rexha" },
    { slug: "sia", name: "Sia" },
  ]},
  { enonce: "Quel groupe mêle dans son nom « jam session » et « Iroquois » ?", correct: 'jamiroquai', choices: [
    { slug: "jamiroquai", name: "Jamiroquai" },
    { slug: "shalamar", name: "Shalamar" },
    { slug: "delegation", name: "Delegation" },
    { slug: "earth-wind-and-fire", name: "Earth, Wind & Fire" },
  ]},
  { enonce: "Quelle chanteuse française a pris son nom de scène dans une série télévisée ?", correct: 'aya-nakamura', choices: [
    { slug: "jain", name: "Jain" },
    { slug: "aya-nakamura", name: "Aya Nakamura" },
    { slug: "zaho", name: "Zaho" },
    { slug: "clara-luciani", name: "Clara Luciani" },
  ]},
  { enonce: "Quel groupe britannique doit son nom à l'initiale de son fondateur, Mike Pickering ?", correct: 'm-people', choices: [
    { slug: "m-people", name: "M People" },
    { slug: "bananarama", name: "Bananarama" },
    { slug: "clean-bandit", name: "Clean Bandit" },
    { slug: "simply-red", name: "Simply Red" },
  ]},
  { enonce: "Quel chanteur français a dû changer le titre de son premier album après une action en justice de Matt Houston ?", correct: 'm-pokora', choices: [
    { slug: "ridsa", name: "Ridsa" },
    { slug: "soprano", name: "Soprano" },
    { slug: "christophe-willem", name: "Christophe Willem" },
    { slug: "m-pokora", name: "M. Pokora" },
  ]},
  { enonce: "Quel DJ français, de son vrai nom Valentin Brunel, a percé à dix-neuf ans ?", correct: 'kungs', choices: [
    { slug: "dj-snake", name: "DJ Snake" },
    { slug: "ofenbach", name: "Ofenbach" },
    { slug: "kungs", name: "Kungs" },
    { slug: "the-avener", name: "The Avener" },
  ]},
  { enonce: "Quelle artiste australienne dissimule son visage en public depuis 2013 ?", correct: 'sia', choices: [
    { slug: "kylie-minogue", name: "Kylie Minogue" },
    { slug: "sia", name: "Sia" },
    { slug: "tame-impala", name: "Tame Impala" },
    { slug: "amy-macdonald", name: "Amy Macdonald" },
  ]},
  { enonce: "Quelle chanteuse britannique a mis sa carrière entre parenthèses pour devenir paysagiste ?", correct: 'kim-wilde', choices: [
    { slug: "anastacia", name: "Anastacia" },
    { slug: "kim-wilde", name: "Kim Wilde" },
    { slug: "sade", name: "Sade" },
    { slug: "bananarama", name: "Bananarama" },
  ]},
  { enonce: "Quel chanteur norvégien a passé seize semaines à réaliser un clip mêlant prises de vues réelles et dessin au crayon ?", correct: 'a-ha', choices: [
    { slug: "modern-talking", name: "Modern Talking" },
    { slug: "simple-minds", name: "Simple Minds" },
    { slug: "baltimora", name: "Baltimora" },
    { slug: "a-ha", name: "A-ha" },
  ]},
  { enonce: "Quelle chanteuse belge est la fille du chanteur Marka et de la comédienne Laurence Bibot ?", correct: 'angele', choices: [
    { slug: "helena", name: "Helena" },
    { slug: "santa", name: "Santa" },
    { slug: "angele", name: "Angèle" },
    { slug: "clara-luciani", name: "Clara Luciani" },
  ]},
];

const faq = [
  { q: "Les réponses de ce quiz peuvent-elles changer ?", a: "Non. Chaque réponse porte sur un fait acquis — une date, un nom, un record établi. Contrairement à un classement d'écoutes, rien ici ne bougera le mois prochain." },
  { q: "D'où viennent ces informations ?", a: "Des fiches artistes du site, dont chaque fait a été vérifié individuellement avant publication. Chaque bonne réponse renvoie vers la fiche correspondante." },
  { q: "Qu'est-ce que le round bonus ?", a: "Un sans-faute sur les 10 questions du round principal débloque 10 questions supplémentaires, pour un score final possible sur 20." },
  { q: "Ces artistes passent-ils vraiment sur Radio Odyssey ?", a: "Oui — tous les artistes cités figurent dans notre <a href='/artistes-diffuses-radio-odyssey.html' style='color:var(--ro-purple);font-weight:700;'>catalogue réel de programmation</a>, avec le détail des titres diffusés." },
];
---
<Layout
  lang="fr"
  title={"Quiz des noms de scène : à qui appartient ce surnom ? | Radio Odyssey"}
  description={"Quiz musical gratuit : 20 noms de scène à attribuer aux artistes diffusés sur Radio Odyssey. Un round bonus se débloque en cas de sans-faute."}
  altLangs={{ fr: '/quiz-noms-artistes-radio-odyssey.html', en: '/en/stage-names-quiz.html' }}
>
  <PageHero
    gradientFrom="#00C6FF"
    gradientTo="#7B2FBE"
    homeLabel="🏠 Accueil"
    breadcrumbCurrent={"Quiz des noms de scène"}
    title={"Quiz des noms de scène : à qui appartient ce surnom ?"}
    text={"Un pull rayé, un roman du XIXᵉ siècle, un entraîneur de football : 20 noms de scène à attribuer."}
  >
    <Fragment slot="icon">
      <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="18" stroke="white" stroke-width="2.3"/><path d="M19 19a5 5 0 1 1 6.5 4.8c-1 .3-1.5 1-1.5 2v1.2" stroke="white" stroke-width="2.3" stroke-linecap="round" fill="none"/><circle cx="24" cy="32.5" r="1.6" fill="white"/></svg>
    </Fragment>
  </PageHero>

  <main class="ro-section" data-pagefind-body>
    <div class="container">
      <div class="row gy-4">
        <div class="col-lg-8">

          <div class="content-card">
            <p style="margin:0;">Un pull rayé, un roman du XIXe siècle, un entraîneur de football, le verlan d'un mot italien : les noms de scène cachent souvent une histoire. Voici 20 questions sur les artistes réellement diffusés sur l'antenne. Un sans-faute sur les 10 premières débloque 10 questions bonus. Toutes les réponses sont tirées de nos <a href="/artistes-diffuses-radio-odyssey.html" style="color:var(--ro-purple);font-weight:700;">fiches artistes</a>, où chaque fait a été vérifié un par un.</p>
          </div>

          <div class="content-card">
            <QuizBlock
              id="quiz-noms-artistes-radio-odyssey"
              main={main}
              bonus={bonus}
              verdicts={{
                parfait: 'Sans-faute intégral — vous connaissez la maison mieux que nous.',
                bon: 'Très joli score. Il reste deux ou trois coulisses à découvrir.',
                moyen: "Bonne base ! Un tour sur les fiches artistes et le sans-faute est à portée.",
                faible: "Tout est sur les fiches artistes — et c'est plutôt agréable à lire.",
              }}
            />
          </div>

          <FAQBlock items={faq} idPrefix="quiz-noms-artistes-radio-odyssey-faq" />

          <RelatedPages
            alsoLike={[
              { href: '/quiz-records-radio-odyssey.html', label: "Quiz des records", desc: 'Un autre quiz sur l\'univers de la radio' },
              { href: '/quiz-coulisses-artistes-radio-odyssey.html', label: "Quiz des coulisses", desc: 'Un autre quiz sur l\'univers de la radio' },
              { href: '/quiz-musicaux-radio-odyssey.html', label: 'Tous nos quiz musicaux', desc: 'Les cinq décennies, 100 questions' },
              { href: '/artistes-diffuses-radio-odyssey.html', label: 'Tous les artistes diffusés', desc: 'Les 147 fiches, avec les titres réellement passés' },
            ]}
            associated={[
              { href: '/styles-musicaux-radio-odyssey.html', label: 'Les styles musicaux de l\'antenne' },
              { href: '/titres-les-plus-diffuses-sur-radio-odyssey.html', label: 'Les titres les plus diffusés' },
              { href: '/artistes-et-styles.html', label: 'Le cocon Artistes & Styles' },
            ]}
          />

          <div class="page-cta-bar">
            <h3>Écoutez ces artistes en direct</h3>
            <a href="#" onclick="roPlayNow(event)" class="btn-hero">
              <Icon name="broadcast-pin" /> Écouter Radio Odyssey
            </a>
          </div>

        </div>
        <div class="col-lg-4">
          <Sidebar />
        </div>
      </div>
    </div>
  </main>
</Layout>
