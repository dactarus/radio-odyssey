const faq = [
  { q: 'Who is Elisabeth Bélot-Grimaud?', a: "She holds a doctorate in cognitive psychology and works as a researcher and lecturer in psychology, specialising in positive mental health. She is the author of « Programmez votre cerveau pour le bonheur », has given two TEDx talks, and hosts the podcast « L'instant Beau Bien Bon »." },
  { q: 'What exactly is her role at Radio Odyssey?', a: "She is Radio Odyssey's exclusive partner. The heart coherence breathing sequences broadcast on air were designed with her, and it is her voice that guides listeners through the breathing, several times a day." },
  { q: 'What is the sinusoidal rhythm in heart coherence breathing?', a: "It is the effect that slow, regular breathing — around 6 breaths per minute — is aiming for: heart rate variability settles into a smooth, wave-like curve associated with a state of physiological calm." },
  { q: 'Where can I find her work outside Radio Odyssey?', a: "On her website santementalepositive.fr, where she publishes free resources on positive mental health — sleep, breathing, emotions, mindfulness and more — organised into biological, cognitive and psychological resources. The site is in French." },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Elisabeth Bélot-Grimaud',
  jobTitle: 'Doctor of cognitive psychology',
  knowsAbout: 'Positive mental health',
