---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Sidebar from '../../components/Sidebar.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import QuizBlock from '../../components/QuizBlock.astro';

/*
  Quiz des coulisses, version anglaise (§97).

  Troisième et dernier quiz thématique traduit. Même méthode qu'aux §94 et
  §96 : un énoncé en prose se réévalue au lieu de se traduire.

  ⚠️ TROIS questions sur vingt sont remplacées — et le choix de la question
  conservée vient du propriétaire, pas d'un tri automatique : *« Jain est
  connu à l'international, pas les 3 autres. »* La question sur « Makeba »
  reste donc telle quelle ; les trois autres partent.

    Jean-Jacques Goldman (l'album « D'eux » pour Céline Dion) → Queen
    Muriel Dacq (production de Léopold Nord & Vous)           → Eurythmics
    Clara Luciani (guitariste de La Femme)                    → The Beatles

  ⚠️ Les trois faits de remplacement sont **déjà publiés et vérifiés dans
  `artists.js`**, côté français (Queen l. 219, Eurythmics l. 2041, The
  Beatles l. 2270). Règle du §86 : on ne crée jamais un fait à l'occasion
  d'une traduction.

  Effet cherché : les trois remplaçants sont de très gros noms, avec fiche
  anglaise — exactement la cible du chantier anglais telle que le
  propriétaire l'a définie (« à l'international on ratisse large avec de très
  gros artistes »).

  ⚠️ Les dix-sept autres questions sont communes aux deux langues : une
  correction d'un côté doit être répercutée de l'autre.

  ⚠️ Chaque artiste n'est bonne réponse qu'une seule fois (20 slugs
  distincts). `correct` porte le slug de la fiche ; `data/quiz-artistes-en.js`
  s'en sert pour afficher le quiz sur la fiche anglaise de l'artiste — à
  condition que le nom du fichier contienne « quiz ».
*/

const main = [
  { enonce: "Which Swedish singer co-wrote “Love Me Like You Do” for Ellie Goulding?", correct: 'tove-lo', choices: [
    { slug: "dua-lipa", name: "Dua Lipa" },
    { slug: "ava-max", name: "Ava Max" },
    { slug: "tove-lo", name: "Tove Lo" },
    { slug: "sia", name: "Sia" },
  ]},
  { enonce: "On which Italian project’s record is the voice not that of the man who appears in the video?", correct: 'baltimora', choices: [
    { slug: "baltimora", name: "Baltimora" },
    { slug: "corona", name: "Corona" },
    { slug: "fun-fun", name: "Fun Fun" },
    { slug: "scotch", name: "Scotch" },
  ]},
  { enonce: "Which American group includes the member who popularised the backslide, the move Michael Jackson turned into the moonwalk?", correct: 'shalamar', choices: [
    { slug: "shalamar", name: "Shalamar" },
    { slug: "the-black-eyed-peas", name: "The Black Eyed Peas" },
    { slug: "delegation", name: "Delegation" },
    { slug: "earth-wind-and-fire", name: "Earth, Wind & Fire" },
  ]},
  { enonce: "Which artist wrote “Children” to give DJs a calming track for the end of the night, hoping to cut the number of road accidents on the way home?", correct: 'robert-miles', choices: [
    { slug: "dario-g", name: "Dario G" },
    { slug: "robert-miles", name: "Robert Miles" },
    { slug: "the-avener", name: "The Avener" },
    { slug: "moby", name: "Moby" },
  ]},
  { enonce: "Which band opened its biggest hit on the date of 21 September, chosen only because it sounded right?", correct: 'earth-wind-and-fire', choices: [
    { slug: "shalamar", name: "Shalamar" },
    { slug: "earth-wind-and-fire", name: "Earth, Wind & Fire" },
    { slug: "kool-and-the-gang", name: "Kool & The Gang" },
    { slug: "imagination", name: "Imagination" },
  ]},
  { enonce: "Which artist licensed all eighteen tracks of one album to advertising or film, a first on that scale?", correct: 'moby', choices: [
    { slug: "daft-punk", name: "Daft Punk" },
    { slug: "moby", name: "Moby" },
    { slug: "robert-miles", name: "Robert Miles" },
    { slug: "avicii", name: "Avicii" },
  ]},
  { enonce: "Which French duo built its one and only hit on a sample of “Soup for One” by Chic?", correct: 'modjo', choices: [
    { slug: "daft-punk", name: "Daft Punk" },
    { slug: "modjo", name: "Modjo" },
    { slug: "ofenbach", name: "Ofenbach" },
    { slug: "bob-sinclar", name: "Bob Sinclar" },
  ]},
  { enonce: "Which American artist saw a 2022 track become a worldwide hit two years later, carried by social media?", correct: 'djo', choices: [
    { slug: "benson-boone", name: "Benson Boone" },
    { slug: "alex-warren", name: "Alex Warren" },
    { slug: "teddy-swims", name: "Teddy Swims" },
    { slug: "djo", name: "Djo" },
  ]},
  { enonce: "Which French singer saw “Makeba”, released in 2015, explode six years after it came out?", correct: 'jain', choices: [
    { slug: "clara-luciani", name: "Clara Luciani" },
    { slug: "jain", name: "Jain" },
    { slug: "zaz", name: "Zaz" },
    { slug: "aya-nakamura", name: "Aya Nakamura" },
  ]},
  { enonce: "Which British artist owes one of his best-known tracks to a drum break that happened by accident in the studio?", correct: 'phil-collins', choices: [
    { slug: "elton-john", name: "Elton John" },
    { slug: "rod-stewart", name: "Rod Stewart" },
    { slug: "sting", name: "Sting" },
    { slug: "phil-collins", name: "Phil Collins" },
  ]},
];

const bonus = [
  { enonce: "Which Scottish band first turned down the song that became its only American number one?", correct: 'simple-minds', choices: [
    { slug: "simply-red", name: "Simply Red" },
    { slug: "simple-minds", name: "Simple Minds" },
    { slug: "texas", name: "Texas" },
    { slug: "a-ha", name: "A-ha" },
  ]},
  { enonce: "Which German DJ produced the remix of “Prayer in C” by the duo Lilly Wood & The Prick?", correct: 'robin-schulz', choices: [
    { slug: "robin-schulz", name: "Robin Schulz" },
    { slug: "kungs", name: "Kungs" },
    { slug: "lost-frequencies", name: "Lost Frequencies" },
    { slug: "r3hab", name: "R3HAB" },
  ]},
  { enonce: "Which band’s most famous song runs five minutes and fifty-five seconds, a length judged impossible for radio at the time?", correct: 'queen', choices: [
    { slug: "supertramp", name: "Supertramp" },
    { slug: "queen", name: "Queen" },
    { slug: "the-cure", name: "The Cure" },
    { slug: "duran-duran", name: "Duran Duran" },
  ]},
  { enonce: "Which singer wrote “Diamonds” for Rihanna before singing “Chandelier” herself?", correct: 'sia', choices: [
    { slug: "sia", name: "Sia" },
    { slug: "lizzo", name: "Lizzo" },
    { slug: "tove-lo", name: "Tove Lo" },
    { slug: "bebe-rexha", name: "Bebe Rexha" },
  ]},
  { enonce: "Which singer made two rival Jamaican political leaders shake hands on stage in 1978?", correct: 'bob-marley', choices: [
    { slug: "lizzo", name: "Lizzo" },
    { slug: "bob-marley", name: "Bob Marley" },
    { slug: "craig-david", name: "Craig David" },
    { slug: "the-weeknd", name: "The Weeknd" },
  ]},
  { enonce: "On which duo’s only UK number one is the harmonica solo played by Stevie Wonder?", correct: 'eurythmics', choices: [
    { slug: "wham", name: "Wham!" },
    { slug: "eurythmics", name: "Eurythmics" },
    { slug: "tears-for-fears", name: "Tears for Fears" },
    { slug: "fine-young-cannibals", name: "Fine Young Cannibals" },
  ]},
  { enonce: "Which British band won four MTV Video Music Awards for a video shot on a moving floor?", correct: 'jamiroquai', choices: [
    { slug: "m-people", name: "M People" },
    { slug: "clean-bandit", name: "Clean Bandit" },
    { slug: "jamiroquai", name: "Jamiroquai" },
    { slug: "simply-red", name: "Simply Red" },
  ]},
  { enonce: "Which band’s recent catalogue versions are built on the original tapes, remixed by the son of its own producer?", correct: 'the-beatles', choices: [
    { slug: "joe-cocker", name: "Joe Cocker" },
    { slug: "the-beatles", name: "The Beatles" },
    { slug: "r-e-m", name: "R.E.M." },
    { slug: "supertramp", name: "Supertramp" },
  ]},
  { enonce: "Which British singer recorded her biggest hit on a song written by her father and her brother?", correct: 'kim-wilde', choices: [
    { slug: "anastacia", name: "Anastacia" },
    { slug: "bananarama", name: "Bananarama" },
    { slug: "kim-wilde", name: "Kim Wilde" },
    { slug: "sade", name: "Sade" },
  ]},
  { enonce: "Which German duo was assembled by producer Dieter Bohlen around the singer Thomas Anders?", correct: 'modern-talking', choices: [
    { slug: "wham", name: "Wham!" },
    { slug: "baltimora", name: "Baltimora" },
    { slug: "modern-talking", name: "Modern Talking" },
    { slug: "a-ha", name: "A-ha" },
  ]},
];

const faq = [
  { q: 'Can the answers to this quiz change?', a: "No. Every answer is a settled fact — a studio accident, a sample, a decision taken decades ago. Unlike a play-count chart, nothing here will move next month." },
  { q: 'Where do these facts come from?', a: "From the artist pages on this site, where every fact was checked individually before publication. Each correct answer points to the artist it belongs to." },
  { q: 'What is the bonus round?', a: "A perfect score on the 10 main questions unlocks 10 more, for a possible final score of 20." },
  { q: 'Do these artists really play on Radio Odyssey?', a: "Yes — every artist named here is in our <a href='/en/artists-on-radio-odyssey.html' style='color:var(--ro-purple);font-weight:700;'>real broadcast catalogue</a>, with the tracks we actually air." },
];
---
<Layout
  lang="en"
  title="Behind the Scenes Quiz — The Stories Behind the Songs | Radio Odyssey"
  description="Free music quiz: 20 studio stories, samples and accidents behind the songs Radio Odyssey plays. A drum break, a moving floor, a handshake in 1978. Bonus round included."
  altLangs={{ fr: '/quiz-coulisses-artistes-radio-odyssey.html', en: '/en/behind-the-scenes-quiz.html' }}
>
  <PageHero
    gradientFrom="#FF9A3C"
    gradientTo="#7B2FBE"
    homeLabel="🏠 Home"
    homeHref="/en.html"
    breadcrumbCurrent="Behind the scenes quiz"
    title="Behind the Scenes Quiz: The Stories Behind the Songs"
    text="A drum break that happened by accident, a floor that moved, a handshake in 1978: 20 stories to place."
  >
    <Fragment slot="icon">
      <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="18" stroke="white" stroke-width="2.3"/><path d="M19 19a5 5 0 1 1 6.5 4.8c-1 .3-1.5 1-1.5 2v1.2" stroke="white" stroke-width="2.3" stroke-linecap="round" fill="none"/><circle cx="24" cy="32.5" r="1.6" fill="white"/></svg>
    </Fragment>
  </PageHero>

  <main class="ro-section" data-pagefind-body>
    <div class="container">
      <div class="row gy-4">
        <div class="col-lg-8">

          <div class="content-card">
            <p style="margin:0;">A drum break that happened by accident, a sample lifted from Chic, a track written to get clubbers home safely, a harmonica solo nobody expects: the best stories are the ones you never hear on the record. Here are 20 questions on artists we genuinely play. A perfect score on the first 10 unlocks 10 bonus questions. Every answer comes from our <a href="/en/artists-on-radio-odyssey.html" style="color:var(--ro-purple);font-weight:700;">artist pages</a>, where each fact was checked one by one.</p>
          </div>

          <div class="content-card">
            <QuizBlock
              lang="en"
              id="en-behind-the-scenes-quiz"
              main={main}
              bonus={bonus}
              verdicts={{
                parfait: 'A clean sweep — you know this station better than we do.',
                bon: 'A very good score. Two or three stories left to discover.',
                moyen: 'Solid start! A look around the artist pages and the clean sweep is within reach.',
                faible: 'It is all on the artist pages — and they are rather pleasant to read.',
              }}
            />
          </div>

          <FAQBlock items={faq} idPrefix="en-behind-the-scenes-quiz-faq" lang="en" />

          <RelatedPages
            lang="en"
            alsoLike={[
              { href: '/en/music-records-quiz.html', label: 'Music Records Quiz', desc: 'Billboard, Grammys, Eurovision, Live Aid' },
              { href: '/en/stage-names-quiz.html', label: 'Stage Names Quiz', desc: 'A striped jumper, a novel, a football manager' },
              { href: '/en/music-quizzes.html', label: 'All Our Music Quizzes', desc: 'Eight quizzes, 160 questions' },
            ]}
            associated={[
              { href: '/en/artists-on-radio-odyssey.html', label: 'All the Artists We Play' },
              { href: '/en/radio-odyssey-faq.html', label: 'Radio Odyssey FAQ' },
              { href: '/en.html', label: 'English home' },
            ]}
          />

          <div class="page-cta-bar">
            <h3>Listen to these artists live</h3>
            <a href="#" onclick="roPlayNow(event)" class="btn-hero">
              <Icon name="broadcast-pin" /> Listen to Radio Odyssey
            </a>
          </div>

        </div>
        <div class="col-lg-4">
          <Sidebar lang="en" />
        </div>
      </div>
    </div>
  </main>
</Layout>
