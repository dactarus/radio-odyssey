---
/*
  Accueil anglais (§81, lot 2). Sort à /en.html et non /en/ : avec
  build.format: 'file', Astro écrit src/pages/en/index.astro dans en.html.

  Écrite pour un public froid — quelqu'un qui arrive d'une recherche en
  anglais sans avoir jamais entendu parler de la station. D'où l'ordre :
  ce que c'est, pourquoi on resterait, comment on écoute. Pas d'historique
  de la radio en tête de page : ça, c'est pour qui est déjà intéressé.

  ⚠️ Tous les faits avancés ici sont repris des pages anglaises existantes
  ou de PROJET_RADIO_ODYSSEY.md. Ne rien y ajouter de mémoire.
*/
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import { EN_NAV_CATEGORIES } from '../../data/i18n.js';
import NowPlaying from '../../components/NowPlaying.astro';
import QuizInvite from '../../components/QuizInvite.astro';

// Les cinq quiz par décennie, pour l'invitation de l'accueil.
const QUIZ_EN = [
  { href: '/en/80s-music-quiz.html',   nom: '80s',   sous: 'Billie Jean, Take On Me…' },
  { href: '/en/90s-music-quiz.html',   nom: '90s',   sous: 'Dance floors and big choruses' },
  { href: '/en/2000s-music-quiz.html', nom: '2000s', sous: 'When pop went global' },
  { href: '/en/2010s-music-quiz.html', nom: '2010s', sous: 'Streaming-era hits' },
  { href: '/en/2020s-music-quiz.html', nom: '2020s', sous: 'The newest additions' },
];

const faq = [
  { q: 'What kind of music does Radio Odyssey play?', a: "Positive music, around the clock: 80s hits reimagined with a modern touch, dance and electro, easy listening and recent releases. Tracks that are melancholy or aggressive are deliberately left out — that editorial choice is the whole point of the station." },
  { q: 'Is it really free?', a: "Yes. Listening is free, with no account, no time limit and no ad breaks in the stream, on every device. There is no paid tier to unlock — there is only one version of Radio Odyssey." },
  { q: 'What are the breathing sequences I sometimes hear?', a: "They are heart coherence breathing sequences — slow, guided breathing at about 5 to 6 breaths per minute — woven directly into the broadcast several times a day. Nothing to install, nothing to start: they come to you while you listen." },
  { q: 'Where is Radio Odyssey broadcast from?', a: "From France, as a non-profit web radio, on air since 19 January 2025. The stream is available worldwide over any internet connection." },
  { q: 'How can I listen?', a: "Press play anywhere on this site, or tune in through TuneIn, Deezer, WeLoveRadio, Orange or Radioline. There is also a free app for your phone." },
];
---
<Layout
  lang="en"
  altLangs={{ fr: '/', en: '/en.html' }}
  title="Radio Odyssey — Free Positive Radio, Live from France"
  description="A free positive web radio streaming worldwide: 80s hits reimagined, dance and easy listening, with guided breathing sequences woven in. No ads, no sign-up."
>
  <PageHero
    gradientFrom="#7B2FBE"
    gradientTo="#FF9A3C"
    breadcrumb={false}
    breadcrumbCurrent="Home"
    title="Music that leaves you better than it found you"
    text="A free positive radio, live from France. No ads, no sign-up, no algorithm — just one continuous stream, with guided breathing woven in."
  >
    <Fragment slot="icon">
      <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="17" stroke="white" stroke-width="2.5"/><path d="M13 24C16 19 19 29 22 24C25 19 28 29 31 24C33 20.5 34 25 35 24" stroke="rgba(255,255,255,.75)" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
    </Fragment>
  </PageHero>

  <main class="ro-section" data-pagefind-body>
    <div class="container">
      <div class="row gy-4">
        <div class="col-lg-8">

          <div class="content-card">
            <h2>One station, one promise</h2>
            <p>Radio Odyssey is a French non-profit web radio that has been on air since 19 January 2025. It plays one thing, deliberately: music that lifts the mood. 80s hits reimagined with a modern touch, dance and electro, easy listening, recent releases — and nothing melancholy or aggressive, because that is the point.</p>
            <p>You do not need an account. You do not need to build a playlist. There is nothing to skip and nothing to rate. Press play, and it keeps going.</p>
            <div class="highlight-box">
              <p style="margin:0;"><strong>The unusual part:</strong> several times a day, a short <a href="/en/heart-coherence-breathing-radio.html" style="color:var(--ro-purple);font-weight:700;">heart coherence breathing sequence</a> is woven straight into the broadcast — slow guided breathing, around 5 to 6 breaths per minute. No app to open, no session to book. It simply comes to you while you are already listening.</p>
            </div>
            <a href="#" onclick="roPlayNow(event)" class="btn-ro" style="cursor:pointer;">
              <Icon name="broadcast-pin" />&nbsp;Listen live now
            </a>
          </div>

          <NowPlaying lang="en" variante="carte" />

          <div class="content-card">
            <h2>Three reasons people stay</h2>
            <h3>No ads, ever — not even a premium tier</h3>
            <p>The stream carries no advertising at all: no audio ads, no pop-ups, no "upgrade to remove ads". The free experience <em>is</em> the experience. <a href="/en/free-radio-no-ads-no-sign-up.html" style="color:var(--ro-purple);font-weight:700;">How that works</a>.</p>
            <h3>Chosen by people, not by a recommendation engine</h3>
            <p>Every track is picked and sequenced by hand, with a consistent positive tone across the whole day. That is a different thing from a generated playlist that drifts wherever your last click pointed. <a href="/en/what-makes-radio-odyssey-different.html" style="color:var(--ro-purple);font-weight:700;">What makes it different</a>.</p>
            <h3>Wellbeing built into the broadcast</h3>
            <p>The breathing sequences were designed with Elisabeth Bélot-Grimaud, a cognitive psychologist and the station's health partner. They are part of the programming, not a separate feature you have to remember to use. <a href="/en/radio-odyssey-vs-meditation-apps.html" style="color:var(--ro-purple);font-weight:700;">Compared with meditation apps</a>.</p>
          </div>

          <QuizInvite lang="en" href="/en/music-quizzes.html" quiz={QUIZ_EN} boutonNombre={5} />

          <div class="content-card">
            <h2>Where to start</h2>
            <p>Everything we publish in English, grouped by what you might be looking for.</p>
            {/* §92 : cette section listait les 29 pages les unes sous les
                autres, en cartes de deux lignes — un défilement interminable,
                sans rapport avec le rythme du reste de la page. Elle tient
                désormais en cinq cartes de groupe, les pages en pastilles.
                Même information, une hauteur d'écran au lieu de quatre. */}
            <div class="ro-portes">
              {EN_NAV_CATEGORIES.map((cat) => (
                <div class="ro-porte">
                  <h3 style="margin:0 0 .15rem;font-size:1rem;"><Icon name={cat.bi} /> {cat.label}</h3>
                  <p style="margin:0 0 .6rem;font-size:.8rem;color:var(--ro-muted);line-height:1.45;">{cat.intro}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:.35rem;">
                    {cat.pages.map((p) => (
                      <a href={p.href} class="tag-pill" style="text-decoration:none;font-size:.76rem;">{p.label}</a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="content-card">
            <h2>Listening from anywhere</h2>
            <p>The stream runs 24/7 and works over any internet connection, wherever you are. Beyond this site, Radio Odyssey is carried on several platforms — the easiest of which, for most people outside France, is <a href="/en/listen-on-tunein.html" style="color:var(--ro-purple);font-weight:700;">TuneIn</a>.</p>
            <ul>
              <li><a href="https://tunein.com/radio/RADIO-ODYSSEY-s339104/" target="_blank" rel="noopener" style="color:var(--ro-purple);font-weight:700;">TuneIn</a> — also the route to smart speakers</li>
              <li><a href="https://www.deezer.com/search/radio%20odyssey/livestream" target="_blank" rel="noopener" style="color:var(--ro-purple);font-weight:700;">Deezer</a>, <a href="https://fr.welove.radio/radio/radio-odyssey/" target="_blank" rel="noopener" style="color:var(--ro-purple);font-weight:700;">WeLoveRadio</a>, <a href="https://radio.orange.com/radios/radio_odyssey" target="_blank" rel="noopener" style="color:var(--ro-purple);font-weight:700;">Orange</a>, <a href="https://www.radioline.co/fr/radios/radio_odyssey" target="_blank" rel="noopener" style="color:var(--ro-purple);font-weight:700;">Radioline</a></li>
              <li><a href="https://app.radio-odyssey.com" target="_blank" rel="noopener" style="color:var(--ro-purple);font-weight:700;">The free app</a> — one screen, one button</li>
            </ul>
            <p>This site can also be installed on your phone or computer straight from your browser, and keeps working offline for everything but the stream itself.</p>
          </div>

          <FAQBlock items={faq} idPrefix="en-home" lang="en" />

          <div class="page-cta-bar">
            <h3>Give it four minutes</h3>
            <p style="margin-bottom:1.2rem;">That is roughly one track and one breathing sequence. It is the fastest way to know whether this is for you.</p>
            <a href="#" onclick="roPlayNow(event)" class="btn-ro" style="cursor:pointer;">
              <Icon name="broadcast-pin" />&nbsp;Listen live now
            </a>
          </div>

        </div>
        <div class="col-lg-4">
          <div class="content-card" style="position:sticky;top:calc(var(--bar-h) + 1.5rem);">
            <h3 style="color:var(--ro-purple);font-size:1rem;"><Icon name="music-note-beamed" /> Listen now</h3>
            <p style="font-size:.85rem;">Radio Odyssey live, 24/7, free and ad-free.</p>
            <a href="#" onclick="roPlayNow(event)" class="btn-ro w-100 justify-content-center mb-3" style="font-size:.88rem;cursor:pointer;">
              <Icon name="broadcast-pin" />&nbsp;Play the radio
            </a>
            <hr style="border-color:rgba(123,47,190,.1);"/>
            <p style="font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--ro-muted);margin:.8rem 0 .4rem;">Explore</p>
            <div style="display:flex;flex-direction:column;gap:.28rem;font-size:.82rem;">
              {EN_NAV_CATEGORIES.map((cat) => (
                <a href={cat.pages[0].href} style="color:var(--ro-purple);text-decoration:none;"><Icon name={cat.bi} /> {cat.label}</a>
              ))}
            </div>
            <hr style="border-color:rgba(123,47,190,.1);"/>
            <p style="font-size:.78rem;color:var(--ro-muted);margin:.6rem 0 0;">Vous cherchez la version française ? <a href="/" style="color:var(--ro-purple);font-weight:700;">Accueil de Radio Odyssey</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Deux colonnes dès qu'il y a la place, une seule sur mobile. La dernière
     carte occupe toute la largeur quand le nombre de groupes est impair —
     sans quoi elle laisse un vide qui déséquilibre la grille. */
  .ro-portes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: .8rem;
    margin-top: 1rem;
  }
  .ro-porte {
    background: linear-gradient(135deg, rgba(123, 47, 190, .05), rgba(255, 60, 172, .035));
    border: 1px solid rgba(123, 47, 190, .12);
    border-radius: 16px;
    padding: 1rem 1.1rem;
  }
  .ro-porte :global(svg) { color: var(--ro-purple); }
  @media (min-width: 576px) {
    .ro-porte:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
</style>
