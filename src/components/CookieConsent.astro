---
import Icon from './Icon.astro';
import { t } from '../data/i18n.js';
// §81 (lot 2) : bandeau traduit. Le lien « en savoir plus » reste vers la
// politique de confidentialité française — obligation légale, seul document
// qui fait foi ; même exception que pour les mentions légales du pied de page.
interface Props { lang?: 'fr' | 'en'; }
const { lang = 'fr' } = Astro.props;
const L = t(lang);
// Bandeau de consentement cookies — Google Analytics n'est chargé
// qu'après acceptation explicite. Choix mémorisé en localStorage.
// "Refuser" a la même importance visuelle qu'"Accepter" (exigence CNIL).
const GA_MEASUREMENT_ID = 'G-6CXEFXNH97';
---
<!-- §80 : plus d'attribut `hidden` par défaut — voir le script bloquant
     ajouté en tête de Layout.astro, qui masque le bandeau avant peinture
     seulement si un choix est déjà enregistré. Un premier visiteur (le cas
     mesuré par Lighthouse) le voit dès la première peinture, sans attendre
     ce script-ci qui ne s'exécute qu'en toute fin de page. -->
<div id="ro-cookie-banner" class="ro-cookie-banner" role="dialog" aria-live="polite" aria-label={L.cookieAria}>
  <div class="ro-cookie-inner">
    <p class="ro-cookie-text">
      <Icon name="cookie" style="color:var(--ro-purple);margin-right:.4rem;" />
      {L.cookieTexte}
      <a href="/politique-de-confidentialite.html" style="color:var(--ro-purple);font-weight:700;text-decoration:underline;">{L.cookieEnSavoirPlus}</a>
    </p>
    <div class="ro-cookie-actions">
      <button type="button" id="ro-cookie-decline" class="ro-cookie-btn ro-cookie-btn-decline">{L.cookieRefuser}</button>
      <button type="button" id="ro-cookie-accept" class="ro-cookie-btn ro-cookie-btn-accept">{L.cookieAccepter}</button>
    </div>
  </div>
</div>

<style is:global>
  /* Posé par le script bloquant de Layout.astro dès qu'un choix est déjà
     enregistré en localStorage — évite tout clignotement du bandeau pour
     un visiteur qui a déjà répondu. */
  html.ro-cookie-decided .ro-cookie-banner { display: none; }
  .ro-cookie-banner {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 2000;
    background: #fff;
    border-top: 2px solid rgba(123,47,190,.15);
    box-shadow: 0 -8px 30px rgba(11,28,45,.15);
    padding: 1.1rem 1.2rem;
  }
  .ro-cookie-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    justify-content: space-between;
  }
  .ro-cookie-text {
    margin: 0;
    font-size: .86rem;
    color: var(--ro-muted);
    flex: 1 1 380px;
  }
  .ro-cookie-actions {
    display: flex;
    gap: .7rem;
    flex-shrink: 0;
  }
  /* Les deux boutons ont exactement le même gabarit (taille, poids de
     police, padding) — seule la couleur change. Le RGPD/la CNIL exige
     que "Refuser" soit aussi facile et visible qu'"Accepter", jamais
     traité comme une option secondaire (pas de bouton "fantôme"). */
  .ro-cookie-btn {
    padding: .6rem 1.4rem;
    font-size: .86rem;
    font-weight: 800;
    font-family: 'Nunito', sans-serif;
    border-radius: 999px;
    border: none;
    cursor: pointer;
  }
  .ro-cookie-btn-accept {
    background: linear-gradient(135deg, var(--ro-purple), var(--ro-pink, #FF3CAC));
    color: #fff;
  }
  .ro-cookie-btn-decline {
    background: #eef0f4;
    color: var(--ro-dark);
  }
  @media (max-width: 575px) {
    .ro-cookie-actions { width: 100%; }
    .ro-cookie-actions button { flex: 1; }
  }
</style>

<script define:vars={{ GA_MEASUREMENT_ID }}>
  (function () {
    /*
      §84 — Les écouteurs étaient posés directement sur #ro-cookie-accept et
      #ro-cookie-decline. Avec ClientRouter (navigation client-side), Astro
      remplace le corps du document mais ne réexécute pas un script en ligne
      dont le contenu n'a pas changé : après le premier changement de page,
      les boutons du bandeau étaient des éléments neufs, sans écouteur, et
      plus rien ne répondait. Sans la moindre erreur en console.

      Le défaut existait depuis l'arrivée de ClientRouter, mais il était
      invisible : avant le §80 le bandeau portait `hidden` par défaut, donc
      après une navigation il restait simplement masqué. Le §80 l'a rendu
      visible par défaut — le bandeau apparaissait alors, inerte.

      Correctif, aligné sur ce que le §80 avait déjà fait pour les menus :
      un seul écouteur délégué sur `document`, qui survit aux remplacements
      de corps, posé une fois grâce au garde-fou ci-dessous.
    */
    if (window.__roCookieBound) return;
    window.__roCookieBound = true;

    var STORAGE_KEY = 'ro-cookie-consent';

    function loadGoogleAnalytics() {
      if (window.roGaLoaded) return;
      window.roGaLoaded = true;

      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    }

    /*
      ⚠️ Le masquage passe par la classe `ro-cookie-decided` sur <html>, et
      non plus par l'attribut `hidden` du bandeau. C'est ce qui le fait tenir
      d'une page à l'autre : <html> n'est pas remplacé par ClientRouter,
      contrairement au bandeau. Avec `hidden`, le choix était oublié à chaque
      changement de page et le bandeau revenait.
    */
    function masquer() {
      document.documentElement.classList.add('ro-cookie-decided');
      var banner = document.getElementById('ro-cookie-banner');
      if (banner) banner.hidden = false;
    }

    function afficher() {
      document.documentElement.classList.remove('ro-cookie-decided');
      var banner = document.getElementById('ro-cookie-banner');
      if (banner) banner.hidden = false;
    }

    /*
      ⚠️ ClientRouter recopie les attributs du <html> entrant sur le document
      courant à chaque navigation : la classe `ro-cookie-decided` posée au
      clic est donc effacée dès le changement de page, et le bandeau
      revenait alors même que le choix était bien enregistré en localStorage.
      L'état est pour cette raison réappliqué après chaque échange de
      document (`astro:after-swap`, déclenché avant peinture, donc sans
      clignotement), et pas seulement au premier chargement.
    */
    function appliquerEtat() {
      var consent = localStorage.getItem(STORAGE_KEY);
      if (consent === 'accepted') { loadGoogleAnalytics(); masquer(); }
      else if (consent === 'declined') { masquer(); }
      else { afficher(); }
    }

    appliquerEtat();
    document.addEventListener('astro:after-swap', appliquerEtat);

    document.addEventListener('click', function (e) {
      var cible = e.target && e.target.closest
        ? e.target.closest('#ro-cookie-accept, #ro-cookie-decline')
        : null;
      if (!cible) return;
      if (cible.id === 'ro-cookie-accept') {
        localStorage.setItem(STORAGE_KEY, 'accepted');
        loadGoogleAnalytics();
      } else {
        localStorage.setItem(STORAGE_KEY, 'declined');
      }
      masquer();
    });

    // Permet de rouvrir le choix depuis le lien "Gérer les cookies" du footer
    window.roOpenCookiePreferences = function () {
      localStorage.removeItem(STORAGE_KEY);
      afficher();
    };
  })();
</script>
