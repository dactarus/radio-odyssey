---
import Icon from './Icon.astro';
import { NAV_CATEGORIES } from '../data/navigation.js';
import { EN_NAV_CATEGORIES, AUTRE_LANGUE, cibleAutreLangue, t } from '../data/i18n.js';
const FOOTER_PAGE_LIMIT = 4;

/*
  §81 (lot 2) : pied de page bilingue. Côté anglais, les colonnes reprennent
  EN_NAV_CATEGORIES — pas les 7 catégories françaises, dont aucune page n'a
  d'équivalent anglais.

  ⚠️ Exception assumée à la règle « pas de lien vers du français depuis une
  page anglaise » : les mentions légales et la politique de confidentialité
  restent liées, en anglais dans le libellé mais vers les pages françaises.
  Ce sont des obligations légales — les retirer d'une page publique serait
  pire qu'un lien dans la mauvaise langue. Le plan du site et le bloc
  partenaire, eux, sont retirés côté anglais : purement éditoriaux.
*/
interface Props { lang?: 'fr' | 'en'; altLangs?: Partial<Record<'fr' | 'en', string>>; }
const { lang = 'fr', altLangs } = Astro.props;
const autreLangue = AUTRE_LANGUE[lang];
const hrefAutreLangue = cibleAutreLangue(lang, altLangs);
const L = t(lang);
const enAnglais = lang === 'en';
const categories = enAnglais ? EN_NAV_CATEGORIES : NAV_CATEGORIES;
const limitePages = enAnglais ? 99 : FOOTER_PAGE_LIMIT;
---
{/* FOOTER */}
<footer id="site-footer">
  <div class="container">
    <div class="row gy-4">
      <div class="col-lg-4">
        <div class="footer-logo-wrap">
          <picture>
            <source srcset="/assets/images/logo.webp" type="image/webp"/>
            <img src="/assets/images/logo.png" alt="Radio Odyssey" width="512" height="512"/>
          </picture>
          <div class="footer-brand">Radio Odyssey<small>{L.footerBaseline}</small></div>
        </div>
        <p style="font-size:.85rem;max-width:280px;">{L.footerDescription}</p>
        <a href="mailto:odysseylaradio@gmail.com" style="color:var(--ro-sky)!important;">odysseylaradio@gmail.com</a>
      </div>
      {categories.map((cat) => (
        <div class="col-sm-6 col-lg-2">
          <h5>{cat.label}</h5>
          {cat.pages.slice(0, limitePages).map((p) => (
            <a href={p.href}>{p.label}</a>
          ))}
          {!enAnglais && cat.pages.length > FOOTER_PAGE_LIMIT && (
            <a href={cat.hub} style="font-weight:700;">{L.voirTout}</a>
          )}
        </div>
      ))}
      <div class="col-sm-6 col-lg-2">
        <h5>{L.ecouterSur}</h5>
        <a href="https://link.radioking.com/radio-odyssey" target="_blank" rel="noopener">RadioKing</a>
        <a href="https://tunein.com/radio/RADIO-ODYSSEY-s339104/" target="_blank" rel="noopener">TuneIn</a>
        <a href="https://www.deezer.com/search/radio%20odyssey/livestream" target="_blank" rel="noopener">Deezer</a>
        <a href="https://fr.welove.radio/radio/radio-odyssey/" target="_blank" rel="noopener">WeLoveRadio</a>
        <a href="https://radio.orange.com/radios/radio_odyssey" target="_blank" rel="noopener">Orange</a>
      </div>
      {!enAnglais && (
        <div class="col-sm-6 col-lg-2">
          <h5>{L.partenaire}</h5>
          <a href="/#partenaire">Santé Mentale Positive</a>
        </div>
      )}
    </div>
    <hr/>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div class="footer-bottom">© 2026 Radio Odyssey. {L.droitsReserves} | {L.depuisLe} · <a href="/mentions-legales.html" style="color:inherit;text-decoration:underline;">{L.mentionsLegales}</a> · <a href="/politique-de-confidentialite.html" style="color:inherit;text-decoration:underline;">{L.confidentialite}</a>{!enAnglais && (<> · <a href="/plan-du-site.html" style="color:inherit;text-decoration:underline;">{L.planDuSite}</a></>)} · <a href="#" onclick="window.roOpenCookiePreferences && window.roOpenCookiePreferences(); return false;" style="color:inherit;text-decoration:underline;">{L.gererCookies}</a> &middot; <a href={hrefAutreLangue} data-astro-reload hreflang={autreLangue.code} lang={autreLangue.code} style="color:inherit;text-decoration:underline;font-weight:700;">{autreLangue.label}</a></div>
      <div class="footer-social d-flex gap-3">
        <a href="https://www.facebook.com/RadioOdysseyFrance" target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
        <a href="https://www.instagram.com/radio_odyssey_france/" target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
        <a href="https://x.com/Odysseylaradio" target="_blank" rel="noopener" aria-label="X"><Icon name="twitter-x" /></a>
        <a href="https://www.youtube.com/channel/UCodzZ_dhFdJwQ90nZzVHluw" target="_blank" rel="noopener" aria-label="YouTube"><Icon name="youtube" /></a>
      </div>
    </div>
  </div>
</footer>

{/* §80 : bootstrap.bundle.min.js retiré. PageSpeed Insights le signalait à
     ~20 Kio de JS quasi entièrement inutilisé — sur les 258 pages, il ne
     servait qu'à trois comportements (FAQ en accordéon, méga-menu déroulant,
     panneau mobile), jamais à ses modales/carrousels/tooltips. Le script
     ci-dessous reproduit ce strict nécessaire à la main. bootstrap.min.css
     reste chargé (voir Layout.astro) : sa grille (row/col-/container) sert
     sur 110+ fichiers, et les classes .collapse/.dropdown-menu/.offcanvas
     qu'il définit continuent de fournir tout l'habillage visuel — seul le
     déclenchement en JavaScript change. */}
<script is:inline src="/assets/js/main.js"></script>
<script is:inline>
(function () {
  function closeDropdowns(except) {
    document.querySelectorAll('.dropdown-menu.show').forEach(function (menu) {
      if (menu === except) return;
      menu.classList.remove('show');
      menu.style.left = '';
      menu.style.right = '';
      var toggle = menu.previousElementSibling;
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    });
  }

  function closeOffcanvas() {
    var panel = document.querySelector('.offcanvas.show');
    if (!panel) return;
    panel.classList.remove('show');
    document.body.style.overflow = '';
    var backdrop = document.querySelector('.ro-offcanvas-backdrop');
    if (backdrop) backdrop.remove();
  }

  function openOffcanvas(panel) {
    panel.classList.add('show');
    document.body.style.overflow = 'hidden';
    var backdrop = document.createElement('div');
    backdrop.className = 'offcanvas-backdrop fade show ro-offcanvas-backdrop';
    backdrop.addEventListener('click', closeOffcanvas);
    document.body.appendChild(backdrop);
  }

  document.addEventListener('click', function (e) {
    // Accordéon FAQ (FAQBlock.astro + index.astro)
    var collapseTrigger = e.target.closest('[data-bs-toggle="collapse"]');
    if (collapseTrigger) {
      var target = document.querySelector(collapseTrigger.getAttribute('data-bs-target'));
      if (target) {
        var showing = target.classList.contains('show');
        target.classList.toggle('show', !showing);
        collapseTrigger.classList.toggle('collapsed', showing);
        collapseTrigger.setAttribute('aria-expanded', String(!showing));
      }
      return;
    }

    // Méga-menu déroulant (MegaNav.astro)
    var dropdownTrigger = e.target.closest('[data-bs-toggle="dropdown"]');
    if (dropdownTrigger) {
      var menu = dropdownTrigger.nextElementSibling;
      if (menu && menu.classList.contains('dropdown-menu')) {
        var isOpen = menu.classList.contains('show');
        closeDropdowns();
        if (!isOpen) {
          menu.classList.add('show');
          dropdownTrigger.setAttribute('aria-expanded', 'true');
          // Remplace le repli automatique que faisait Popper (inclus dans
          // le bundle complet) : si le menu déborderait de la fenêtre à
          // droite, on l'aligne sur la droite du bouton plutôt qu'à gauche.
          var r = menu.getBoundingClientRect();
          if (r.right > window.innerWidth) {
            menu.style.left = 'auto';
            menu.style.right = '0';
          }
        }
      }
      return;
    }
    if (!e.target.closest('.dropdown-menu')) closeDropdowns();

    // Panneau mobile (Header.astro)
    var offcanvasTrigger = e.target.closest('[data-bs-toggle="offcanvas"]');
    if (offcanvasTrigger) {
      var panel = document.querySelector(offcanvasTrigger.getAttribute('data-bs-target'));
      if (panel) openOffcanvas(panel);
      return;
    }
    if (e.target.closest('[data-bs-dismiss="offcanvas"]')) closeOffcanvas();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeDropdowns(); closeOffcanvas(); }
  });
})();
</script>

<script is:inline>
/* ── Radio Odyssey : lecture adaptée desktop/mobile ── */
function roUmamiTrack(name, data){
  data = data || {};
  // Ajouté ici une seule fois plutôt que sur chaque appel : permet de
  // croiser le taux d'échec/succès de lecture avec le type de navigateur
  // (Instagram/Facebook bloquent souvent l'autoplay sans le signaler).
  data.in_app_browser = (typeof window.roIsInAppBrowser === 'function') ? window.roIsInAppBrowser() : false;
  if(typeof umami !== 'undefined' && umami.track){
    try { umami.track(name, data); } catch(err){}
  }
}

/* Point d'entrée historique de la lecture. Il est appelé en onclick depuis
   95 pages et depuis la barre latérale : son nom et sa signature ne doivent
   pas changer. Seul le moteur a été remplacé — l'iframe RadioKing a laissé
   place au lecteur natif (voir RadioPlayer.astro).

   L'appel reste synchrone dans le geste de l'utilisateur, condition
   indispensable pour que les navigateurs autorisent la lecture audio. */
function roPlayNow(e){
  if(e){ e.preventDefault(); e.stopPropagation(); }

  if(typeof window.roPlayerToggle === 'function'){
    window.roPlayerToggle(e);
    return;
  }

  // Secours : le composant lecteur ne s'est pas initialisé (script bloqué,
  // erreur JS en amont). On retombe sur le comportement d'avant plutôt que
  // de laisser l'auditeur sans rien.
  var isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent)
                 || window.innerWidth <= 767;
  roUmamiTrack('play_click', { device: isMobile ? 'mobile' : 'desktop', method: 'secours-lecteur-absent' });
  var win = window.open('https://link.radioking.com/radio-odyssey', '_blank');
  if(!win) roUmamiTrack('play_error', { device: isMobile ? 'mobile' : 'desktop', reason: 'popup_blocked' });
}

/* Sorties plateformes (§72) : plutôt que d'ajouter un onclick sur chaque
   lien "Télécharger l'application" (une trentaine de pages) et chaque lien
   d'écoute externe (RadioKing, TuneIn, Deezer, WeLoveRadio, Orange...), un
   seul écouteur délégué au clic couvre l'ensemble du site, présent et futur
   — cohérent avec le principe du projet d'éviter la duplication à la main.
   PLATEFORMES doit rester aligné avec le tableau SAME_AS de Layout.astro. */
var PLATEFORMES = {
  'link.radioking.com': 'radioking',
  'tunein.com': 'tunein',
  'deezer.com': 'deezer',
  'welove.radio': 'welove',
  'radio.orange.com': 'orange',
  'radioline.co': 'radioline',
  'mytuner-radio.com': 'mytuner',
};
document.addEventListener('click', function (e) {
  var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
  if (!a) return;
  var href = a.getAttribute('href') || '';
  if (href.indexOf('app.radio-odyssey.com') !== -1) {
    roUmamiTrack('app_download_click', { page: location.pathname });
    return;
  }
  for (var host in PLATEFORMES) {
    if (href.indexOf(host) !== -1) {
      roUmamiTrack('external_platform_click', { platform: PLATEFORMES[host], page: location.pathname });
      break;
    }
  }
});

/* Installation PWA (§72) : 'appinstalled' est l'événement standard du
   navigateur, déclenché après toute installation réussie — qu'elle vienne
   de l'icône native de la barre d'adresse ou du menu "Ajouter à l'écran
   d'accueil". Pas besoin d'un bouton dédié pour la capter. */
window.addEventListener('appinstalled', function () {
  roUmamiTrack('pwa_installed', { page: location.pathname });
});
</script>
