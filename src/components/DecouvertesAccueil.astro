---
/*
  Bandeau « Découvertes » des deux accueils (§112 français, §113 anglais).

  La page des Découvertes n'était liée ni depuis l'accueil ni depuis le menu :
  le visiteur qui n'arrive que sur l'accueil ne pouvait pas la voir. Ce bandeau
  en montre les trois plus récentes.

  Aucune donnée propre : tout vient de `discoveries.js`. Les Découvertes encore
  en rotation (`active`) y sont lues dans l'ordre du tableau, la plus récente
  en dernier, donc ajouter une entrée suffit à la faire apparaître ici.

  ⚠️ Côté anglais, seules les fiches qui ont une version anglaise
  (`discoveries-en.js`) sont montrées, avec les libellés de genre et d'origine
  anglais, et les liens vont vers `/en/…` : un lien vers du français depuis une
  page anglaise est proscrit (§82).
  ⚠️ Deux variantes de présentation, comme `NowPlaying.astro` : `section`
  (pleine largeur, accueil français) et `carte` (dans une colonne, accueil
  anglais). Pas de CSS global : `page-card` et `section-eyebrow` viennent de
  `style.css`, tout le reste est en ligne — rien n'est à recopier ailleurs.
*/
import Icon from './Icon.astro';
import { DISCOVERIES } from '../data/discoveries.js';
import { DISCOVERIES_EN, SLUGS_DISCOVERIES_EN } from '../data/discoveries-en.js';

interface Props { lang?: 'fr' | 'en'; variante?: 'section' | 'carte'; }
const { lang = 'fr', variante = 'section' } = Astro.props;
const en = lang === 'en';
const enCarte = variante === 'carte';

const NB_AFFICHEES = 3;
const recentes = DISCOVERIES
  .filter((a) => a.active && (!en || SLUGS_DISCOVERIES_EN.includes(a.slug)))
  .slice(-NB_AFFICHEES)
  .reverse();

// Titre court pour la carte : on coupe à la première parenthèse (« feat. … »),
// la fiche de l'artiste donne le titre complet.
const titreCourt = (t) => t.replace(/\s*\(.*$/, '');

const T = en
  ? {
      chapeau: 'Radio Odyssey Discoveries',
      titreAvant: 'The talents we ',
      titreFort: 'support',
      accroche: 'Emerging artists, picked one by one by the radio, outside any ranking. On air right now:',
      tout: 'See all Discoveries',
      proposer: 'Artist, label or record company? Send us a track.',
      hub: '/en/discoveries.html',
      fiche: (slug) => `/en/discovery-${slug}.html`,
      genre: (a) => `${DISCOVERIES_EN[a.slug].genre} — ${DISCOVERIES_EN[a.slug].origin}`,
    }
  : {
      chapeau: 'Découvertes Radio Odyssey',
      titreAvant: 'Les talents que nous ',
      titreFort: 'soutenons',
      accroche: 'Des artistes émergents, choisis un par un par la radio, en dehors de tout classement. En rotation en ce moment :',
      tout: 'Voir toutes les Découvertes',
      proposer: 'Artiste, label ou maison de disques ? Proposez-nous un titre.',
      hub: '/decouvertes-radio-odyssey.html',
      fiche: (slug) => `/decouverte-${slug}.html`,
      genre: (a) => `${a.genre} — ${a.origin}`,
    };
---
{recentes.length > 0 && (enCarte
  ? (
    <div class="content-card" style="border-left:4px solid var(--ro-gold);">
      <div class="text-center mb-4">
        <span class="section-eyebrow">{T.chapeau}</span>
        <h2 style="margin:.2rem 0 .5rem;">{T.titreAvant}<span class="highlight">{T.titreFort}</span></h2>
        <p class="text-muted" style="max-width:560px;margin:0 auto;font-size:.93rem;">{T.accroche}</p>
      </div>
      <div class="row g-3">
        {recentes.map((a) => (
          <div class="col-md-12 col-xl-4">
            <a class="page-card" href={T.fiche(a.slug)}>
              <div class="pg-icon"><Icon name="stars" style="color:var(--ro-purple);" /></div>
              <div>
                <h4>{a.name}</h4>
                <p>{T.genre(a)}</p>
                <p style="margin-top:.3rem;color:var(--ro-purple);font-weight:700;">♪ {titreCourt(a.tracks[0])}</p>
              </div>
            </a>
          </div>
        ))}
      </div>
      <p class="text-center" style="margin:1.4rem 0 0;font-size:.9rem;">
        <a href={T.hub} style="color:var(--ro-purple);font-weight:700;text-decoration:none;">{T.tout} <Icon name="arrow-right" /></a>
      </p>
      <p class="text-center" style="margin:.5rem 0 0;font-size:.8rem;"><a href={T.hub} class="text-muted" style="text-decoration:underline;">{T.proposer}</a></p>
    </div>
  )
  : (
    <section class="ro-section" style="padding-top:0;padding-bottom:2.6rem;">
      <div class="container">
        <div style="background:#fff;border-radius:22px;border-left:4px solid var(--ro-gold);box-shadow:var(--ro-shadow-sm);padding:2rem 1.6rem;">
          <div class="text-center mb-4">
            <span class="section-eyebrow">{T.chapeau}</span>
            <h2 style="margin:.2rem 0 .5rem;">{T.titreAvant}<span class="highlight">{T.titreFort}</span></h2>
            <p class="text-muted" style="max-width:560px;margin:0 auto;font-size:.93rem;">{T.accroche}</p>
          </div>
          <div class="row g-3">
            {recentes.map((a) => (
              <div class="col-md-4">
                <a class="page-card" href={T.fiche(a.slug)}>
                  <div class="pg-icon"><Icon name="stars" style="color:var(--ro-purple);" /></div>
                  <div>
                    <h4>{a.name}</h4>
                    <p>{T.genre(a)}</p>
                    <p style="margin-top:.3rem;color:var(--ro-purple);font-weight:700;">♪ {titreCourt(a.tracks[0])}</p>
                  </div>
                </a>
              </div>
            ))}
          </div>
          <p class="text-center" style="margin:1.4rem 0 0;font-size:.9rem;">
            <a href={T.hub} style="color:var(--ro-purple);font-weight:700;text-decoration:none;">{T.tout} <Icon name="arrow-right" /></a>
          </p>
          <p class="text-center" style="margin:.5rem 0 0;font-size:.8rem;"><a href={T.hub} class="text-muted" style="text-decoration:underline;">{T.proposer}</a></p>
        </div>
      </div>
    </section>
  )
)}
