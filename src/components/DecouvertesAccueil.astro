---
/*
  Bandeau « Découvertes » de l'accueil (§112).

  La page des Découvertes n'était liée ni depuis l'accueil ni depuis le menu :
  le visiteur qui n'arrive que sur l'accueil ne pouvait pas la voir. Ce bandeau
  en montre les trois plus récentes.

  Aucune donnée propre : tout vient de `discoveries.js`. Les Découvertes encore
  en rotation (`active`) y sont lues dans l'ordre du tableau, la plus récente
  en dernier, donc ajouter une entrée suffit à la faire apparaître ici.

  ⚠️ Accueil français seulement. Le hub « Découvertes » n'existe pas en anglais,
  et un lien vers du français depuis l'accueil anglais est proscrit (§82).
  ⚠️ Pas de CSS global : `page-card` et `section-eyebrow` viennent de
  `style.css`, tout le reste est en ligne — rien n'est à recopier ailleurs.
*/
import Icon from './Icon.astro';
import { DISCOVERIES } from '../data/discoveries.js';

const NB_AFFICHEES = 3;
const recentes = DISCOVERIES.filter((a) => a.active).slice(-NB_AFFICHEES).reverse();

// Titre court pour la carte : on coupe à la première parenthèse (« feat. … »),
// la fiche de l'artiste donne le titre complet.
const titreCourt = (t) => t.replace(/\s*\(.*$/, '');
---
{recentes.length > 0 && (
  <section class="ro-section" style="padding-top:0;padding-bottom:2.6rem;">
    <div class="container">
      <div style="background:#fff;border-radius:22px;border-left:4px solid var(--ro-gold);box-shadow:var(--ro-shadow-sm);padding:2rem 1.6rem;">
        <div class="text-center mb-4">
          <span class="section-eyebrow">Découvertes Radio Odyssey</span>
          <h2 style="margin:.2rem 0 .5rem;">Les talents que nous <span class="highlight">soutenons</span></h2>
          <p class="text-muted" style="max-width:560px;margin:0 auto;font-size:.93rem;">
            Des artistes émergents, choisis un par un par la radio, en dehors de tout classement. En rotation en ce moment :
          </p>
        </div>
        <div class="row g-3">
          {recentes.map((a) => (
            <div class="col-md-4">
              <a class="page-card" href={`/decouverte-${a.slug}.html`}>
                <div class="pg-icon"><Icon name="stars" style="color:var(--ro-purple);" /></div>
                <div>
                  <h4>{a.name}</h4>
                  <p>{a.genre} — {a.origin}</p>
                  <p style="margin-top:.3rem;color:var(--ro-purple);font-weight:700;">♪ {titreCourt(a.tracks[0])}</p>
                </div>
              </a>
            </div>
          ))}
        </div>
        <p class="text-center" style="margin:1.4rem 0 0;font-size:.9rem;">
          <a href="/decouvertes-radio-odyssey.html" style="color:var(--ro-purple);font-weight:700;text-decoration:none;">Voir toutes les Découvertes <Icon name="arrow-right" /></a>
        </p>
        <p class="text-center" style="margin:.5rem 0 0;font-size:.8rem;"><a href="/decouvertes-radio-odyssey.html" class="text-muted" style="text-decoration:underline;">Artiste, label ou maison de disques ? Proposez-nous un titre.</a></p>
      </div>
    </div>
  </section>
)}
