---
import Icon from './Icon.astro';
import MegaNav from './MegaNav.astro';
import RadioPlayer from './RadioPlayer.astro';
import { NAV_CATEGORIES, MENU_APERCU } from '../data/navigation.js';
---
<!-- ============================================================
     PLAYER BAR STICKY
     ============================================================ -->
<div id="topRadioBar" transition:persist transition:name="player-bar">

  <!-- GAUCHE : logo + badge -->
  <a class="bar-logo" href="/" aria-label="Radio Odyssey — Accueil">
    <picture>
      <source srcset="/assets/images/logo.webp" type="image/webp"/>
      <img class="bar-logo-img" src="/assets/images/logo.png" alt="Radio Odyssey"
           width="512" height="512" onerror="this.style.opacity='0'"/>
    </picture>
  </a>
  <div class="live-badge">
    <span class="live-dot"></span>
    EN DIRECT
  </div>

  <!-- CENTRE : lecteur natif, identique sur mobile et ordinateur.
       Remplace l'iframe RadioKing et le bouton mobile qui ouvrait un onglet
       externe. Voir RadioPlayer.astro pour le détail du choix. -->
  <RadioPlayer />

  <!-- DROITE : wave + burger -->
  <div class="bar-wave" aria-hidden="true">
    <span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
  </div>
  <button class="bar-burger"
          data-bs-toggle="offcanvas"
          data-bs-target="#site-nav"
          aria-controls="site-nav"
          aria-label="Ouvrir le menu"
          style="margin-right:16px;">
    <Icon name="list" />
  </button>

</div>

<!-- Le script d'iframe RadioKing a été retiré avec l'iframe : il ne servait
     qu'à dimensionner le lecteur embarqué. Une dépendance tierce en moins
     sur le chemin de rendu. -->

<!-- ============================================================
     MEGA-MENU (desktop)
     ============================================================ -->
<MegaNav />

<!-- ============================================================
     OFFCANVAS NAV (mobile)
     ============================================================ -->
<div class="offcanvas offcanvas-start" id="site-nav" tabindex="-1" aria-labelledby="nav-label">
  <div class="offcanvas-header">
    <div class="offcanvas-title" id="nav-label">
      <picture>
        <source srcset="/assets/images/logo.webp" type="image/webp"/>
        <img src="/assets/images/logo.png" alt="Logo Radio Odyssey" width="512" height="512"/>
      </picture>
      Radio Odyssey
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
  </div>
  <div class="offcanvas-body p-2">

    <button type="button" class="nav-link ro-search-trigger w-100 text-start" data-bs-dismiss="offcanvas"
            style="background:none;border:none;cursor:pointer;">
      <span class="ni"><Icon name="search" /></span> Rechercher sur le site
    </button>

    <span class="nav-cat"><Icon name="house-door-fill" /> Accueil</span>
    <a class="nav-link" href="/"><span class="ni"><Icon name="house-door-fill" /></span> Page d'accueil</a>

    {/* Aperçu des MENU_APERCU premières pages par catégorie, comme sur le
        méga-menu desktop. Le reste passe par le hub de catégorie et par le
        plan du site — voir le commentaire dans navigation.js. */}
    {NAV_CATEGORIES.map((cat) => (
      <>
        <span class="nav-cat"><Icon name={cat.bi} /> {cat.label}</span>
        {cat.pages.slice(0, MENU_APERCU).map((p) => (
          <a class="nav-link" href={p.href}><span class="ni"><Icon name={p.bi} /></span> {p.label}</a>
        ))}
        <a class="nav-link nav-link-hub" href={cat.hub}>
          <span class="ni"><Icon name="arrow-right" /></span> <strong>Voir les {cat.pages.length} pages</strong>
        </a>
      </>
    ))}

    <span class="nav-cat"><Icon name="list" /> Tout le site</span>
    <a class="nav-link" href="/plan-du-site.html"><span class="ni"><Icon name="grid" /></span> Plan du site</a>

    <div class="offcanvas-cta">
      <a class="btn-ro w-100 justify-content-center"
         href="https://link.radioking.com/radio-odyssey" target="_blank" rel="noopener"
         onclick="if(typeof roUmamiTrack==='function')roUmamiTrack('play_click',{source:'offcanvas-menu'});">
        <Icon name="broadcast" />&nbsp; Écouter en Direct
      </a>
    </div>
  </div>
</div>
