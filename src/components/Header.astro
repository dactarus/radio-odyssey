---
import Icon from './Icon.astro';
import MegaNav from './MegaNav.astro';
import RadioPlayer from './RadioPlayer.astro';
import { NAV_CATEGORIES, MENU_APERCU } from '../data/navigation.js';
import { EN_NAV_CATEGORIES, ACCUEIL, AUTRE_LANGUE, cibleAutreLangue, t } from '../data/i18n.js';

/*
  §81 (lot 2) : la navigation était écrite en dur en français. Les 13 pages
  anglaises affichaient donc un menu illisible pour leur lecteur — le premier
  obstacle pour un public froid arrivant par une recherche en anglais.

  Côté anglais, ce n'est pas le menu français traduit : c'est une structure
  propre (EN_NAV_CATEGORIES), courte, sur les seules pages anglaises. Les 108
  pages françaises n'y figurent pas — un lien n'est montré que si sa cible
  existe dans la langue de la page.
*/
interface Props { lang?: 'fr' | 'en'; altLangs?: Partial<Record<'fr' | 'en', string>>; }
const { lang = 'fr', altLangs } = Astro.props;
const autreLangue = AUTRE_LANGUE[lang];
const hrefAutreLangue = cibleAutreLangue(lang, altLangs);
const L = t(lang);
const categories = lang === 'en' ? EN_NAV_CATEGORIES : NAV_CATEGORIES;
// Les groupes anglais tiennent en 5 ou 6 entrées : tout est affiché, et il
// n'y a pas de page de hub vers laquelle renvoyer.
const apercu = lang === 'en' ? 99 : MENU_APERCU;
const avecHub = lang !== 'en';
const accueil = ACCUEIL[lang];
---
<!-- ============================================================
     PLAYER BAR STICKY
     ============================================================ -->
<div id="topRadioBar" transition:persist transition:name="player-bar">

  <!-- GAUCHE : logo + badge -->
  <a class="bar-logo" href={accueil} aria-label={L.accueilAria}>
    <picture>
      <source srcset="/assets/images/logo.webp" type="image/webp"/>
      <img class="bar-logo-img" src="/assets/images/logo.png" alt="Radio Odyssey"
           width="512" height="512" onerror="this.style.opacity='0'"/>
    </picture>
  </a>
  <div class="live-badge">
    <span class="live-dot"></span>
    {L.enDirect}
  </div>

  <!-- CENTRE : lecteur natif, identique sur mobile et ordinateur.
       Remplace l'iframe RadioKing et le bouton mobile qui ouvrait un onglet
       externe. Voir RadioPlayer.astro pour le détail du choix. -->
  <RadioPlayer lang={lang} />

  <!-- DROITE : wave + burger -->
  <div class="bar-wave" aria-hidden="true">
    <span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
  </div>
  <button class="bar-burger"
          data-bs-toggle="offcanvas"
          data-bs-target="#site-nav"
          aria-controls="site-nav"
          aria-label={L.ouvrirMenu}
          style="margin-right:16px;">
    <Icon name="list" />
  </button>

</div>

<!-- Le script d'iframe RadioKing a été retiré avec l'iframe : il ne servait
     qu'à dimensionner le lecteur embarqué. Une dépendance tierce en moins
     sur le chemin de rendu. -->

<!-- ============================================================
     MEGA-MENU (desktop)
     ============================================================ -->
<MegaNav lang={lang} altLangs={altLangs} />

<!-- ============================================================
     OFFCANVAS NAV (mobile)
     ============================================================ -->
<div class="offcanvas offcanvas-start" id="site-nav" tabindex="-1" aria-labelledby="nav-label">
  <div class="offcanvas-header">
    <div class="offcanvas-title" id="nav-label">
      <picture>
        <source srcset="/assets/images/logo.webp" type="image/webp"/>
        <img src="/assets/images/logo.png" alt="Logo Radio Odyssey" width="512" height="512"/>
      </picture>
      Radio Odyssey
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label={L.fermer}></button>
  </div>
  <div class="offcanvas-body p-2">

    <button type="button" class="nav-link ro-search-trigger w-100 text-start" data-bs-dismiss="offcanvas"
            style="background:none;border:none;cursor:pointer;">
      <span class="ni"><Icon name="search" /></span> {L.rechercher}
    </button>

    <span class="nav-cat"><Icon name="house-door-fill" /> {L.accueil}</span>
    <a class="nav-link" href={accueil}><span class="ni"><Icon name="house-door-fill" /></span> {L.pageAccueil}</a>

    {/* Aperçu des MENU_APERCU premières pages par catégorie, comme sur le
        méga-menu desktop. Le reste passe par le hub de catégorie et par le
        plan du site — voir le commentaire dans navigation.js. */}
    {categories.map((cat) => (
      <>
        <span class="nav-cat"><Icon name={cat.bi} /> {cat.label}</span>
        {cat.pages.slice(0, apercu).map((p) => (
          <a class="nav-link" href={p.href}><span class="ni"><Icon name={p.bi} /></span> {p.label}</a>
        ))}
        {avecHub && (
          <a class="nav-link nav-link-hub" href={cat.hub}>
            <span class="ni"><Icon name="arrow-right" /></span> <strong>{L.voirLesPages(cat.pages.length)}</strong>
          </a>
        )}
      </>
    ))}

    <span class="nav-cat"><Icon name="globe" /> {autreLangue.label}</span>
    <a class="nav-link" href={hrefAutreLangue} data-astro-reload hreflang={autreLangue.code} lang={autreLangue.code}><span class="ni"><Icon name="globe" /></span> {autreLangue.label}</a>

    <span class="nav-cat"><Icon name="list" /> {L.toutLeSite}</span>
    <a class="nav-link" href={lang === 'en' ? accueil : '/plan-du-site.html'}><span class="ni"><Icon name="grid" /></span> {L.planDuSite}</a>

    <div class="offcanvas-cta">
      <a class="btn-ro w-100 justify-content-center"
         href="https://link.radioking.com/radio-odyssey" target="_blank" rel="noopener"
         onclick="if(typeof roUmamiTrack==='function')roUmamiTrack('play_click',{source:'offcanvas-menu'});">
        <Icon name="broadcast" />&nbsp; {L.ecouterEnDirect}
      </a>
    </div>
  </div>
</div>
