---
/*
  §84 — Même défaut que sur le bandeau cookies : les écouteurs étaient posés
  directement sur `.ro-search-trigger`, `#ro-search-close` et le fond.
  ClientRouter remplace le corps du document sans réexécuter un script en
  ligne inchangé : après la première navigation client-side, la loupe ne
  répondait plus, sans erreur en console. Défaut présent depuis l'arrivée de
  ClientRouter.

  Trois conséquences traitées dans le script :
    - écouteurs délégués sur `document`, posés une seule fois ;
    - `#ro-search-modal` et `#ro-search-ui` relus à chaque ouverture, jamais
      mémorisés : ce sont des éléments neufs après chaque navigation ;
    - interface Pagefind réinstanciée si le conteneur de la page courante est
      vide, sans recharger le script (window.PagefindUI reste en mémoire).

  ⚠️ Les libellés viennent d'attributs `data-` de la modale, pas de
  `define:vars` : ils suivent la langue de la page réellement affichée, et le
  script n'a aucune constante à redéclarer.
*/
import Icon from './Icon.astro';
import { t } from '../data/i18n.js';

/*
  §81 (lot 2) : libellés de la recherche traduits.

  ⚠️ Pagefind construit un index par langue à partir de l'attribut `lang` de
  <html> et sert celui de la page courante : une recherche depuis une page
  anglaise ne remonte donc que des pages anglaises. C'est le comportement
  voulu — mais il rend l'index anglais très petit (17 pages). Si un jour la
  recherche paraît vide côté anglais, c'est cela, pas un bug.
*/
interface Props { lang?: 'fr' | 'en'; }
const { lang = 'fr' } = Astro.props;
const L = t(lang);
---
<div id="ro-search-modal" class="ro-search-modal" hidden aria-hidden="true"
     data-placeholder={L.recherchePlaceholder} data-zero-results={L.rechercheAucunResultat}>
  <div class="ro-search-backdrop"></div>
  <div class="ro-search-panel" role="dialog" aria-modal="true" aria-label={L.rechercher}>
    <div class="ro-search-header">
      <span class="ro-search-title"><Icon name="search" /> {L.rechercheTitre}</span>
      <button type="button" id="ro-search-close" class="ro-search-close" aria-label={L.rechercheFermer}>&times;</button>
    </div>
    <div id="ro-search-ui"></div>
  </div>
</div>

<style is:global>
  .ro-search-modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
  }
  .ro-search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 28, 45, .55);
  }
  .ro-search-panel {
    position: relative;
    max-width: 640px;
    margin: 8vh auto 0;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 18px;
    box-shadow: var(--ro-shadow-lg, 0 20px 60px rgba(0,0,0,.3));
    overflow: hidden;
  }
  .ro-search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid rgba(123,47,190,.1);
    flex-shrink: 0;
  }
  .ro-search-title {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: .95rem;
    color: var(--ro-dark);
  }
  .ro-search-close {
    width: 30px; height: 30px;
    border-radius: 50%;
    border: none;
    background: #eef0f4;
    color: var(--ro-dark);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
  }
  #ro-search-ui {
    padding: 1rem 1.2rem 1.4rem;
    overflow-y: auto;
  }

  /* Thème Pagefind aligné sur la charte Radio Odyssey */
  .pagefind-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--ro-purple);
    --pagefind-ui-text: var(--ro-dark);
    --pagefind-ui-background: #fff;
    --pagefind-ui-border: rgba(123,47,190,.15);
    --pagefind-ui-tag: rgba(123,47,190,.08);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: 'Inter', sans-serif;
  }

  @media (max-width: 600px) {
    .ro-search-panel { margin: 0; max-height: 100vh; height: 100vh; border-radius: 0; }
  }
</style>

<script is:inline>
(function () {
  // Écouteurs délégués, éléments relus à chaque usage — voir l'en-tête du fichier (§84).
  if (window.__roSearchBound) return;
  window.__roSearchBound = true;

  function laModale() { return document.getElementById('ro-search-modal'); }

  function chargerUI(callback) {
    var conteneur = document.getElementById('ro-search-ui');
    var modale = laModale();
    if (!conteneur || !modale) { callback(); return; }
    if (conteneur.children.length) { callback(); return; }

    if (!document.querySelector('link[data-ro-pagefind]')) {
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/pagefind/pagefind-ui.css';
      link.setAttribute('data-ro-pagefind', '');
      document.head.appendChild(link);
    }

    function instancier() {
      try {
        new PagefindUI({
          element: '#ro-search-ui',
          showSubResults: true,
          showImages: false,
          excerptLength: 15,
          translations: {
            placeholder: modale.dataset.placeholder || '',
            zero_results: modale.dataset.zeroResults || ''
          }
        });
      } catch (err) { /* recherche indisponible : la page reste utilisable */ }
      callback();
    }

    if (window.PagefindUI) { instancier(); return; }
    var script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = instancier;
    document.body.appendChild(script);
  }

  function ouvrir() {
    var modale = laModale();
    if (!modale) return;
    modale.hidden = false;
    modale.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    chargerUI(function () {
      var champ = document.querySelector('#ro-search-ui input');
      if (champ) champ.focus();
    });
  }

  function fermer() {
    var modale = laModale();
    if (!modale) return;
    modale.hidden = true;
    modale.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', function (e) {
    if (!e.target || !e.target.closest) return;
    if (e.target.closest('.ro-search-trigger')) { ouvrir(); return; }
    if (e.target.closest('#ro-search-close') || e.target.closest('.ro-search-backdrop')) { fermer(); }
  });

  document.addEventListener('keydown', function (e) {
    var modale = laModale();
    if (e.key === 'Escape' && modale && !modale.hidden) fermer();
  });
})();
</script>
