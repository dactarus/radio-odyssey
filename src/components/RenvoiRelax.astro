---
/*
  Renvoi de fin de page vers Radio Odyssey Relax (§106).

  Une suite de lecture, pas une publicité : le bloc se pose APRÈS le contenu
  éditorial, une fois la question du visiteur traitée, et avant la barre
  d'appel de la page. Jamais en bandeau, jamais au milieu du texte, un seul
  par page — ces pages captent grâce à leur contenu, et un renvoi mal placé
  écourterait la visite.

  Tant que RELAX_LANCEE est faux, rien n'est rendu : le jour J, les cinq
  renvois apparaissent avec la station, sans une ligne à écrire.

  `href` est facultatif : sans lui, le texte s'affiche sans lien. C'est le cas
  de musique-pour-la-nuit tant que la page « Nuit » de Radio Odyssey Relax
  n'existe pas — ne jamais deviner son adresse.

  Habillage : le dégradé adouci de Relax (charte Relax §03, #F55EA8 → #7562D9
  → #42B9F8), jamais celui d'Odyssey — c'est ce qui signale qu'on parle de
  l'autre station. Texte en encre, lien en lavande, aucun aplat saturé.

  ⚠️ Écrire « Radio Odyssey Relax » en entier, jamais « Relax » seul, et ne
  jamais promettre d'effet de santé.
*/
import { RELAX_LANCEE } from '../data/groupe.js';

const { titre, texte, href = null, libelle = 'Découvrir Radio Odyssey Relax' } = Astro.props;
---
{RELAX_LANCEE && (
  <section class="renvoi-relax" data-pagefind-ignore>
    <p class="renvoi-relax-titre">{titre}</p>
    <p class="renvoi-relax-texte">{texte}</p>
    {href && <p class="renvoi-relax-lien"><a href={href}>{libelle} &rarr;</a></p>}
  </section>
)}

<style>
  .renvoi-relax {
    position: relative;
    margin: 0 0 1.5rem;
    padding: 1.4rem 1.6rem 1.4rem 1.9rem;
    border-radius: 16px;
    background: #F6F4FA;
    border: 1px solid #E0DAEE;
    overflow: hidden;
  }
  .renvoi-relax::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: linear-gradient(135deg, #F55EA8, #7562D9 46%, #42B9F8);
  }
  .renvoi-relax p { margin: 0; }
  .renvoi-relax-titre {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 1.05rem;
    color: #7048C0;
    margin-bottom: .35rem;
  }
  .renvoi-relax-texte {
    font-size: .95rem;
    line-height: 1.65;
    color: #1A1626;
  }
  .renvoi-relax-lien { margin-top: .7rem; }
  .renvoi-relax-lien a {
    color: #7048C0;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(112, 72, 192, .35);
  }
  .renvoi-relax-lien a:hover { border-bottom-color: #7048C0; }
</style>
